op_get_regions() {
  local with_az=false
  has include-availability-zones && with_az=true
  jq -n --argjson az "$with_az" '
    def region($name; $disp; $cc; $desc): {continentCode: $cc, description: $desc, displayName: $disp, name: $name}
      + (if $az then {availabilityZones: [ {zoneName: ($name + "a"), state: "available"}, {zoneName: ($name + "b"), state: "available"} ],
                      relationalDatabaseAvailabilityZones: []} else {} end);
    {regions: [
      region("us-east-1"; "Virginia"; "NA"; "This region is recommended to serve users in the eastern United States"),
      region("us-west-2"; "Oregon"; "NA"; "This region is recommended to serve users in the western United States"),
      region("eu-west-1"; "Ireland"; "EU"; "This region is recommended to serve users in Ireland, the United Kingdom, and Iceland"),
      region("eu-central-1"; "Frankfurt"; "EU"; "This region is recommended to serve users in Germany, Austria, Switzerland and eastern Europe"),
      region("ap-southeast-1"; "Singapore"; "AS"; "This region is recommended to serve users in Singapore and southeast Asia")
    ]}'
}
