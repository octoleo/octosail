    {blueprintId: "debian_12", name: "Debian", group: "debian_12", type: "os", description: "Debian 12", isActive: true, minPower: 0, version: "12", versionCode: "1", productUrl: "https://aws.amazon.com/marketplace/pp/B0BWCYK7HH", licenseUrl: "https://www.debian.org/legal/licenses/", platform: "LINUX_UNIX", appCategory: null},
    {blueprintId: "amazon_linux_2023", name: "Amazon Linux 2023", group: "amazon_linux_2023", type: "os", description: "Amazon Linux 2023", isActive: true, minPower: 0, version: "2023", versionCode: "1", productUrl: "https://aws.amazon.com/linux/amazon-linux-2023/", licenseUrl: "https://aws.amazon.com/agreement/", platform: "LINUX_UNIX", appCategory: null}
