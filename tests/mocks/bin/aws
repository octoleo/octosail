op_get_caller_identity() {
  jq -n --arg a "$ACCOUNT" '{UserId: "AIDAMOCKUSER0000000000", Account: $a, Arn: ("arn:aws:iam::" + $a + ":user/octosail-test")}'
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
if [[ $SERVICE == sts ]]; then
  case $OP in
    get-caller-identity) op_get_caller_identity ;;
    *) echo "Unknown mock operation $OP" >&2; exit 96 ;;
  esac
  exit 0
fi

case $OP in
  create-instances) op_create_instances CreateInstance "" ;;
  create-instances-from-snapshot) require instance-snapshot-name; op_create_instances CreateInstancesFromSnapshot "$(param instance-snapshot-name)" ;;
  get-instance) op_get_instance ;;
  get-instances) op_get_instances ;;
  get-instance-state) op_get_instance_state ;;
  get-instance-access-details) op_get_instance_access_details ;;
  get-instance-port-states) op_get_instance_port_states ;;
  open-instance-public-ports) op_open_ports ;;
  close-instance-public-ports) op_close_ports ;;
  put-instance-public-ports) op_put_ports ;;
  start-instance) op_start_instance ;;
  stop-instance) op_stop_instance ;;
  reboot-instance) op_reboot_instance ;;
  delete-instance) op_delete_instance ;;
  get-operation) op_get_operation ;;
  get-operations) op_get_operations ;;
  get-operations-for-resource) op_get_operations_for_resource ;;
  tag-resource) op_tag_resource ;;
  untag-resource) op_untag_resource ;;
  create-key-pair) op_create_key_pair ;;
  import-key-pair) op_import_key_pair ;;
  get-key-pair) op_get_key_pair ;;
  get-key-pairs) op_get_key_pairs ;;
  delete-key-pair) op_delete_key_pair ;;
  download-default-key-pair) op_download_default_key_pair ;;
  allocate-static-ip) op_allocate_static_ip ;;
  attach-static-ip) op_attach_static_ip ;;
  detach-static-ip) op_detach_static_ip ;;
  release-static-ip) op_release_static_ip ;;
  get-static-ip) op_get_static_ip ;;
  get-static-ips) op_get_static_ips ;;
  create-instance-snapshot) op_create_instance_snapshot ;;
  get-instance-snapshot) op_get_instance_snapshot ;;
  get-instance-snapshots) op_get_instance_snapshots ;;
  delete-instance-snapshot) op_delete_instance_snapshot ;;
  get-regions) op_get_regions ;;
  get-blueprints) op_get_blueprints ;;
  get-bundles) op_get_bundles ;;
  *) echo "Unknown mock operation $OP" >&2; exit 96 ;;
esac
