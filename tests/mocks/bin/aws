    {price: 24.0, cpuCount: 2, diskSizeInGb: 80, bundleId: "medium_3_0", instanceType: "medium", isActive: true, name: "Medium", power: 2000, ramSizeInGb: 4.0, transferPerMonthInGb: 4096, supportedPlatforms: ["LINUX_UNIX"], supportedAppCategories: [], publicIpv4AddressCount: 1}
