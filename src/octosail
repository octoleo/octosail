# os::take_positional_name ARG - the single positional instance name.
os::take_positional_name() {
    (( ${#POSITIONALS[@]} == 0 )) || os::die "$EX_USAGE" "unexpected argument '$1' (the instance name was already given)"
    POSITIONALS+=("$1")
    OPT_SHIFT=1
}

# os::apply_positional_name - merge the positional name into OPT_NAME.
os::apply_positional_name() {
    if (( ${#POSITIONALS[@]} )); then
        if [[ $OPT_NAME_FROM_FLAG == true && $OPT_NAME != "${POSITIONALS[0]}" ]]; then
            os::die "$EX_USAGE" "conflicting instance names '--name $OPT_NAME' and '${POSITIONALS[0]}'"
        fi
        OPT_NAME=${POSITIONALS[0]}
    fi
}

os::parse_create_args() {
    os::opts_from_env_common
    os::opts_from_env_ssh 300
    os::opts_from_env_create
    while (( $# )); do
        os::opt_split "$@"
        case $OPT_FLAG in
            --) os::die "$EX_USAGE" "create does not take arguments after '--'" ;;
            -n|--name) os::opt_take; OPT_NAME=$OPT_VALUE; OPT_NAME_FROM_FLAG=true ;;
            -*) os::parse_opt_global || os::parse_opt_ssh || os::parse_opt_create || os::die "$EX_USAGE" "unknown option '$OPT_FLAG' for create (see 'octosail help create')" ;;
            *) os::die "$EX_USAGE" "create takes no positional argument; use --name NAME" ;;
        esac
        shift "$OPT_SHIFT"
    done
}

os::parse_delete_args() {
    os::opts_from_env_common
    os::opts_from_env_delete
    while (( $# )); do
