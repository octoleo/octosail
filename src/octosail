os::parse_opt_delete() {
    case $OPT_FLAG in
        --wait) os::opt_bool; OPT_WAIT=$BOOL ;;
        --no-wait) os::opt_flag; OPT_WAIT=false ;;
        --snapshot-first) os::opt_bool; if [[ $BOOL == true ]]; then OPT_SNAPSHOT_FIRST=true; else OPT_SNAPSHOT_FIRST=""; fi ;;
