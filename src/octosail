os::globals_from_env() {
    if os::in_actions; then
        IN_ACTIONS=true
    fi
    os::set_log_level "${OCTOSAIL_LOG_LEVEL:-info}"
    if [[ -t 2 && -z ${NO_COLOR:-} && ${OCTOSAIL_NO_COLOR:-false} != true && ${TERM:-} != dumb && $IN_ACTIONS != true ]]; then
        COLOR_ENABLED=true
    fi
    JSON_MODE=${OCTOSAIL_JSON:-false}
    DRY_RUN=${OCTOSAIL_DRY_RUN:-false}
    KEEP_TEMP=${OCTOSAIL_KEEP_TEMP:-false}
    ASSUME_YES=${OCTOSAIL_YES:-false}
    POLL_INTERVAL=${OCTOSAIL_POLL_INTERVAL:-5}
    (( POLL_INTERVAL >= 1 )) || POLL_INTERVAL=1
    POLL_INTERVAL_MAX=${OCTOSAIL_POLL_INTERVAL_MAX:-15}
    (( POLL_INTERVAL_MAX >= POLL_INTERVAL )) || POLL_INTERVAL_MAX=$POLL_INTERVAL
    SLEEP_FACTOR=${OCTOSAIL_SLEEP_FACTOR:-1}
    GLOBAL_TIMEOUT=${OCTOSAIL_TIMEOUT:-1800}
    GLOBAL_DEADLINE=$((SECONDS + GLOBAL_TIMEOUT))
    OUTPUT_FILE=${GITHUB_OUTPUT:-}
    OUTPUT_PREFIX=${OCTOSAIL_OUTPUT_PREFIX:-}
    STEP_SUMMARY=${OCTOSAIL_STEP_SUMMARY:-true}
    TMP_PARENT=${OCTOSAIL_TMPDIR:-${RUNNER_TEMP:-${TMPDIR:-/tmp}}}
    AWS_BIN=${OCTOSAIL_AWS_BIN:-aws}
    AWS_RETRIES=${OCTOSAIL_AWS_RETRIES:-4}
    AWS_RETRY_BASE=${OCTOSAIL_AWS_RETRY_BASE:-2}
    AWS_RETRY_CAP=${OCTOSAIL_AWS_RETRY_CAP:-30}
    OPERATION_TIMEOUT=${OCTOSAIL_OPERATION_TIMEOUT:-300}
    OUTPUT_MAX_BYTES=${OCTOSAIL_OUTPUT_MAX_BYTES:-65536}
    REGION=${OCTOSAIL_REGION:-}
    PROFILE=${OCTOSAIL_PROFILE:-}
    os::split_lines "${OCTOSAIL_AWS_EXTRA_ARGS:-}" AWS_EXTRA_ARGS
}

os::is_command() {
    local w
    for w in $COMMANDS; do
        [[ $w == "$1" ]] && return 0
    done
    return 1
}

# os::dispatch COMMAND ARGS...
os::dispatch() {
    local cmd=$1
    shift
    COMMAND=$cmd
    POSITIONALS=()
    REST_ARGS=()
    "cmd_$cmd" "$@"
}

main() {
    os::install_traps
    local -a args=("$@")
    local i a config="" cmd
    if (( $# == 2 )); then
        case $1 in
            --stop) args=(stop --no-wait "$2"); LEGACY=true ;;
            --start) args=(start --no-wait "$2"); LEGACY=true ;;
            --reboot) args=(reboot --hard --wait "$2"); LEGACY=true ;;
        esac
    fi
    for (( i = 0; i < ${#args[@]}; i++ )); do
        a=${args[i]}
        [[ $a == -- ]] && break
        if [[ $a == --config ]]; then
            config=${args[i + 1]:-}
        elif [[ $a == --config=* ]]; then
            config=${a#*=}
        fi
    done
    OUTPUT_FILE=${GITHUB_OUTPUT:-}
    if os::in_actions; then
        IN_ACTIONS=true
    fi
    case ${OCTOSAIL_JSON:-} in
        1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]|[Yy]) JSON_MODE=true ;;
    esac
    local early_level=""
    for (( i = 0; i < ${#args[@]}; i++ )); do
        a=${args[i]}
        [[ $a == -- ]] && break
        case $a in
            --json|--json=true) JSON_MODE=true ;;
            -v|--verbose) early_level=3 ;;
            -q|--quiet) early_level=1 ;;
            --log-level=*) case ${a#*=} in error) early_level=0 ;; warn|warning) early_level=1 ;; info) early_level=2 ;; debug) early_level=3 ;; esac ;;
            --log-level) case ${args[i + 1]:-} in error) early_level=0 ;; warn|warning) early_level=1 ;; info) early_level=2 ;; debug) early_level=3 ;; esac ;;
        esac
    done
    os::out_declare exit_code exit_name octosail_version
    [[ -n $config ]] || config=${OCTOSAIL_CONFIG:-}
    if [[ -z $config ]]; then
        config=$(os::config_find)
    elif [[ $config != /dev/null && ! -f $config ]]; then
        os::die "$EX_USAGE" "config file '$config' not found"
    fi
    os::config_load "$config"
    os::env_normalise
    os::globals_from_env
    [[ -n $early_level ]] && LOG_LEVEL_NUM=$early_level
    set -- "${args[@]+"${args[@]}"}"
    while (( $# )); do
        os::opt_split "$@"
        case $OPT_FLAG in
            --) break ;;
            -*) os::parse_opt_global || os::die "$EX_USAGE" "unknown option '$OPT_FLAG' (see 'octosail help')" ;;
            *) break ;;
        esac
        shift "$OPT_SHIFT"
    done
    if (( $# == 0 )); then
        usage_main >&2
        os::die "$EX_USAGE" "no command given"
    fi
    cmd=$1
    shift
    os::is_command "$cmd" || os::die "$EX_USAGE" "unknown command '$cmd' (see 'octosail help')"
    if [[ $LEGACY == true ]]; then
        os::warn "legacy syntax; use 'octosail $cmd NAME' (see 'octosail help $cmd')"
    fi
    case $cmd in
        help|version)
            os::dispatch "$cmd" "$@"
            EXIT_CODE=0
            exit 0
            ;;
    esac
    if [[ $cmd != doctor ]]; then
        os::require_cmd jq
    fi
    os::mkrundir
    os::dispatch "$cmd" "$@"
    EXIT_CODE=${EXIT_CODE:-$EX_OK}
    exit "$EXIT_CODE"
}

if [[ -z ${OCTOSAIL_SOURCED:-} ]]; then
    main "$@"
fi
