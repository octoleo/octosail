            esac
            ;;
        --cloud-init-strict) os::opt_bool; OPT_CLOUD_INIT_STRICT=$BOOL ;;
        --create-timeout) os::opt_seconds; OPT_CREATE_TIMEOUT=$SECS ;;
        --cloud-init-timeout) os::opt_seconds; OPT_CLOUD_INIT_TIMEOUT=$SECS ;;
        --delete-timeout) os::opt_seconds; OPT_DELETE_TIMEOUT=$SECS ;;
        *) return 1 ;;
    esac
    return 0
}

