# os::kv LABEL VALUE - one row of the human-readable table on stdout.
os::kv() {
    [[ $JSON_MODE == true ]] && return 0
    printf '%-18s %s\n' "$1" "${2:-}"
}

# os::instance_outputs - outputs shared by create/status/run from INST_*.
os::instance_outputs() {
    os::out name "$INST_NAME"
    os::out state "$INST_STATE"
    os::out public_ip "$INST_PUBLIC_IP"
    os::out private_ip "$INST_PRIVATE_IP"
    os::out ipv6_addresses "$INST_IPV6"
    os::out username "$INST_USERNAME"
    os::out region "${INST_REGION:-$REGION}"
    os::out availability_zone "$INST_AZ"
    os::out blueprint_id "$INST_BLUEPRINT"
    os::out bundle_id "$INST_BUNDLE"
    os::out arn "$INST_ARN"
    os::out key_pair_name "$INST_KEY_NAME"
    os::out static_ip_name "$(os::instance_tag "$TAG_STATIC_IP")"
    os::out expires_at "$(os::instance_tag "$TAG_EXPIRES")"
    JSON_INSTANCE=$INST_JSON
}

# os::instance_table - human summary of INST_*.
os::instance_table() {
    os::kv "name" "$INST_NAME"
    os::kv "state" "$INST_STATE"
    os::kv "public ip" "$INST_PUBLIC_IP"
    os::kv "private ip" "$INST_PRIVATE_IP"
    [[ -n $INST_IPV6 ]] && os::kv "ipv6" "$INST_IPV6"
    os::kv "username" "$INST_USERNAME"
    os::kv "blueprint" "$INST_BLUEPRINT"
    os::kv "bundle" "$INST_BUNDLE"
    os::kv "zone" "$INST_AZ"
    os::kv "key pair" "$INST_KEY_NAME"
    os::kv "static ip" "$(os::instance_tag "$TAG_STATIC_IP")"
    os::kv "managed" "$(os::instance_tag "$TAG_MANAGED")"
    os::kv "protected" "$(os::instance_tag "$TAG_PROTECTED")"
    os::kv "expires at" "$(os::instance_tag "$TAG_EXPIRES")"
    os::kv "created at" "$INST_CREATED_AT"
    return 0
}

# os::resolve_name - OPT_NAME from flag/positional/env, then the Actions default.
os::resolve_name() {
    if [[ -z $OPT_NAME ]]; then
        OPT_NAME=$(os::default_name)
    fi
    os::validate_name "$OPT_NAME"
}

# os::user_data_load - USER_DATA from --user-data / --user-data-file (- = stdin).
USER_DATA=""
os::user_data_load() {
    USER_DATA=""
    OPT_USER_DATA_GIVEN=false
    if [[ -n $OPT_USER_DATA && -n $OPT_USER_DATA_FILE ]]; then
        os::die "$EX_USAGE" "--user-data and --user-data-file are mutually exclusive"
    fi
    if [[ -n $OPT_USER_DATA ]]; then
        USER_DATA=$OPT_USER_DATA
        OPT_USER_DATA_GIVEN=true
    elif [[ -n $OPT_USER_DATA_FILE ]]; then
        if [[ $OPT_USER_DATA_FILE == - ]]; then
            USER_DATA=$(cat) || os::die "$EX_USAGE" "cannot read user data from stdin"
        else
            [[ -r $OPT_USER_DATA_FILE ]] || os::die "$EX_USAGE" "user data file '$OPT_USER_DATA_FILE' is not readable"
            USER_DATA=$(cat "$OPT_USER_DATA_FILE")
        fi
        OPT_USER_DATA_GIVEN=true
    fi
}

# os::script_load OUT_FILE - the exec script body from --script-file / -- words / OCTOSAIL_SCRIPT / stdin.
os::script_load() {
    local out=$1 sources=0
    [[ -n $OPT_SCRIPT_FILE ]] && sources=$((sources + 1))
    (( ${#REST_ARGS[@]} )) && sources=$((sources + 1))
    if (( sources > 1 )); then
        os::die "$EX_USAGE" "give the script either with --script-file or after '--', not both"
    fi
    if (( ${#REST_ARGS[@]} )); then
        printf '%s\n' "${REST_ARGS[*]}" >"$out"
        OPT_SCRIPT_SOURCE="arguments"
    elif [[ -n $OPT_SCRIPT_FILE ]]; then
        if [[ $OPT_SCRIPT_FILE == - ]]; then
            cat >"$out" || os::die "$EX_USAGE" "cannot read the script from stdin"
            OPT_SCRIPT_SOURCE="stdin"
        else
            [[ -r $OPT_SCRIPT_FILE ]] || os::die "$EX_USAGE" "script file '$OPT_SCRIPT_FILE' is not readable"
            cat "$OPT_SCRIPT_FILE" >"$out"
            OPT_SCRIPT_SOURCE="file:$OPT_SCRIPT_FILE"
        fi
    elif [[ -n $OPT_SCRIPT ]]; then
        printf '%s\n' "$OPT_SCRIPT" >"$out"
        OPT_SCRIPT_SOURCE="OCTOSAIL_SCRIPT"
    elif [[ ! -t 0 ]] && [[ $OPT_SCRIPT_SOURCE != none ]]; then
        cat >"$out" || true
        OPT_SCRIPT_SOURCE="stdin"
    else
        : >"$out"
    fi
    if [[ ! -s $out || -z $(tr -d '[:space:]' <"$out") ]]; then
        os::die "$EX_USAGE" "no script or command given (use -- COMMAND, --script-file FILE, OCTOSAIL_SCRIPT or stdin)"
    fi
}

# os::capture_dir NAME - where exec output is captured (empty = no capture).
os::capture_dir() {
    local name=$1 want=$OPT_CAPTURE
    if [[ -z $want ]]; then
        if [[ $IN_ACTIONS == true && -n $OUTPUT_FILE ]] || [[ $JSON_MODE == true ]]; then
            want=true
        else
            want=false
        fi
    fi
    if [[ $JSON_MODE == true ]]; then
        want=true
    fi
    [[ $want == true ]] || { printf ''; return 0; }
    if [[ -n $OPT_CAPTURE_DIR ]]; then
        printf '%s/%s' "$OPT_CAPTURE_DIR" "$name"
    elif [[ -n ${RUNNER_TEMP:-} ]]; then
        printf '%s/octosail/%s' "$RUNNER_TEMP" "$name"
    else
        printf '%s/octosail/%s' "$TMP_PARENT" "$name"
    fi
}

# os::ensure_running NAME - the instance must be running (or be started with --start-if-stopped).
os::ensure_running() {
    local name=$1 rc=0
    os::instance_get "$name" || rc=$?
    (( rc == EX_NOTFOUND )) && os::die "$EX_NOTFOUND" "instance '$name' does not exist"
    case $INST_STATE in
        running) return 0 ;;
        stopped)
            if [[ $OPT_START_IF_STOPPED == true ]]; then
                os::info "instance '$name' is stopped; starting it"
                os::aws_must lightsail start-instance --instance-name "$name"
                os::op_wait "$AWS_OUT"
                os::state_wait "$name" running "$OPT_STATE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$name' did not reach 'running' within ${OPT_STATE_TIMEOUT}s"
                os::instance_get "$name" || true
                return 0
            fi
            os::die "$EX_STATE" "instance '$name' is stopped (use --start-if-stopped or 'octosail start $name')"
            ;;
        pending|starting|rebooting)
            os::info "instance '$name' is $INST_STATE; waiting for running"
            os::state_wait "$name" running "$OPT_STATE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$name' did not reach 'running' within ${OPT_STATE_TIMEOUT}s"
            os::instance_get "$name" || true
            return 0
            ;;
        *) os::die "$EX_STATE" "instance '$name' is in state '$INST_STATE'; it must be running" ;;
    esac
}

###############################################################################
# create
###############################################################################

# os::create_flow NAME - create or reuse an instance; wait; ports; static IP; ssh; cloud-init.
os::create_flow() {
    local name=$1 rc=0 expires="" tag tags_json ipname kp_tags='[]' op
    local -a args=() user_tags=()
    CREATE_CREATED=false
    CREATE_REUSED=false
    os::out_declare name created reused state public_ip private_ip ipv6_addresses username region availability_zone \
        blueprint_id bundle_id arn key_pair_name static_ip_name expires_at ssh_ready cloud_init_status
    os::out name "$name"
    [[ -n $OPT_AZ ]] || OPT_AZ="${REGION}a"
    [[ $OPT_AZ == "$REGION"* ]] || os::die "$EX_USAGE" "availability zone '$OPT_AZ' is not in region '$REGION'"
    if [[ -n $OPT_STATIC_IP_NAME && $OPT_STATIC_IP == true ]]; then
        os::die "$EX_USAGE" "--static-ip and --static-ip-name are mutually exclusive"
    fi
    os::user_data_load
    for tag in "${OPT_OPEN_PORTS[@]+"${OPT_OPEN_PORTS[@]}"}"; do
        os::parse_port_spec "$tag"
    done
    for tag in "${OPT_TAGS[@]+"${OPT_TAGS[@]}"}"; do
        [[ $tag == *=* ]] || os::die "$EX_USAGE" "tag '$tag' must be KEY=VALUE"
        [[ $tag != "$TAG_PREFIX"* ]] || os::die "$EX_USAGE" "tag '$tag' uses the reserved '$TAG_PREFIX' prefix"
        user_tags+=("$tag")
    done
    if [[ -n $OPT_TTL ]]; then
        os::to_seconds "$OPT_TTL" "--ttl"
        expires=$(os::epoch_to_iso $(( $(os::now_epoch) + SECS )))
    fi
    os::instance_get "$name" || rc=$?
    if (( rc == 0 )); then
        case $OPT_IF_EXISTS in
            fail) os::die "$EX_CONFLICT" "instance '$name' already exists (--if-exists fail)" ;;
            replace)
                os::info "instance '$name' exists; replacing it"
                rc=0
                (
                    OPT_WAIT=true
                    OPT_IF_MISSING=ok
                    os::delete_flow "$name"
                ) || rc=$?
                if (( rc == EX_REFUSED )); then
                    os::die "$EX_REFUSED" "instance '$name' exists and may not be replaced (see the refusal above)"
                fi
                (( rc == 0 )) || os::die "$EX_CLEANUP" "could not delete the existing instance '$name' (exit $rc)"
                rc=$EX_NOTFOUND
                ;;
            reuse)
                CREATE_REUSED=true
                CLEANUP_INSTANCE_EXISTS=true
                os::info "reusing existing instance '$name' (state: $INST_STATE)"
                if [[ -n $OPT_BLUEPRINT && $INST_BLUEPRINT != "$OPT_BLUEPRINT" ]]; then
                    os::warn "existing instance uses blueprint '$INST_BLUEPRINT', not '$OPT_BLUEPRINT'"
                fi
                if [[ -n $OPT_BUNDLE && $INST_BUNDLE != "$OPT_BUNDLE" ]]; then
                    os::warn "existing instance uses bundle '$INST_BUNDLE', not '$OPT_BUNDLE'"
                fi
                case $INST_STATE in
                    stopped)
                        os::info "starting stopped instance '$name'"
                        os::aws_must lightsail start-instance --instance-name "$name"
                        os::op_wait "$AWS_OUT"
                        ;;
                    stopping)
                        os::info "instance '$name' is stopping; waiting for it to stop before starting it again"
                        os::state_wait "$name" stopped "$OPT_STATE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$name' did not stop within ${OPT_STATE_TIMEOUT}s"
                        os::aws_must lightsail start-instance --instance-name "$name"
                        os::op_wait "$AWS_OUT"
                        ;;
                    shutting-down)
                        os::info "instance '$name' is shutting down; waiting for it to disappear before creating a new one"
                        os::absent_wait "$name" "$OPT_DELETE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$name' still shutting down after ${OPT_DELETE_TIMEOUT}s"
                        CREATE_REUSED=false
                        CLEANUP_INSTANCE_EXISTS=false
                        rc=$EX_NOTFOUND
                        ;;
                    terminated) os::die "$EX_STATE" "instance '$name' is terminated" ;;
                esac
                ;;
            *) os::die "$EX_USAGE" "--if-exists must be reuse, fail or replace (got '$OPT_IF_EXISTS')" ;;
        esac
    fi
    if (( rc == EX_NOTFOUND )); then
        if [[ -n $OPT_PUBLIC_KEY_FILE ]]; then
            os::key_pair_ensure "$OPT_PUBLIC_KEY_FILE" "$OPT_KEY_PAIR"
            OPT_KEY_PAIR=$KEY_PAIR_NAME
            if [[ -n $KEY_PAIR_IMPORTED_NAME ]]; then
                kp_tags=$(os::json_tags "$TAG_KEY_PAIR=$KEY_PAIR_IMPORTED_NAME")
            fi
        elif [[ -n $OPT_KEY_PAIR ]]; then
            rc=0
            os::aws lightsail get-key-pair --key-pair-name "$OPT_KEY_PAIR" || rc=$?
            (( rc == EX_NOTFOUND )) && os::die "$EX_NOTFOUND" "key pair '$OPT_KEY_PAIR' does not exist in $REGION (use --public-key-file to import one)"
            (( rc == 0 )) || os::die "$EX_AWS" "get-key-pair $OPT_KEY_PAIR failed: $AWS_ERR"
        fi
        local -a base_tags=("$TAG_MANAGED=true" "$TAG_VERSION=$_VERSION" "$TAG_CREATED=$(os::now_iso)")
        [[ -n $expires ]] && base_tags+=("$TAG_EXPIRES=$expires")
        if [[ $IN_ACTIONS == true ]]; then
            [[ -n ${GITHUB_RUN_ID:-} ]] && base_tags+=("$TAG_RUN_ID=$GITHUB_RUN_ID")
            [[ -n ${GITHUB_REPOSITORY:-} ]] && base_tags+=("$TAG_REPO=$GITHUB_REPOSITORY")
        fi
        [[ $OPT_STATIC_IP == true ]] && base_tags+=("$TAG_STATIC_IP=octosail-$name")
        tags_json=$(jq -cn --argjson a "$(os::json_tags "${base_tags[@]}")" --argjson b "$(os::json_tags "${user_tags[@]+"${user_tags[@]}"}")" --argjson c "$kp_tags" '$a + $b + $c')
        args=(--instance-names "$(jq -cn --arg n "$name" '[$n]')" --availability-zone "$OPT_AZ" --bundle-id "$OPT_BUNDLE" --tags "$tags_json")
        [[ -n $USER_DATA ]] && args+=(--user-data "$USER_DATA")
        [[ -n $OPT_KEY_PAIR ]] && args+=(--key-pair-name "$OPT_KEY_PAIR")
        [[ -n $OPT_IP_ADDRESS_TYPE ]] && args+=(--ip-address-type "$OPT_IP_ADDRESS_TYPE")
        if [[ -n $OPT_FROM_SNAPSHOT ]]; then
            rc=0
            os::aws lightsail get-instance-snapshot --instance-snapshot-name "$OPT_FROM_SNAPSHOT" || rc=$?
            (( rc == EX_NOTFOUND )) && os::die "$EX_NOTFOUND" "snapshot '$OPT_FROM_SNAPSHOT' does not exist"
            (( rc == 0 )) || os::die "$EX_AWS" "get-instance-snapshot failed: $AWS_ERR"
            if [[ $(jq -r '.instanceSnapshot.state // empty' <<<"$AWS_OUT") != available ]]; then
                os::die "$EX_STATE" "snapshot '$OPT_FROM_SNAPSHOT' is not available yet"
            fi
            [[ -n $OPT_BLUEPRINT && $OPT_BLUEPRINT != "$DEFAULT_BLUEPRINT" ]] && os::warn "--blueprint is ignored with --from-snapshot"
            op=create-instances-from-snapshot
            args+=(--instance-snapshot-name "$OPT_FROM_SNAPSHOT")
            os::info "creating instance '$name' from snapshot '$OPT_FROM_SNAPSHOT' ($OPT_BUNDLE in $OPT_AZ)"
        else
            op=create-instances
            args+=(--blueprint-id "$OPT_BLUEPRINT")
            os::info "creating instance '$name' ($OPT_BLUEPRINT, $OPT_BUNDLE in $OPT_AZ)"
        fi
        rc=0
        RUN_CREATED=true
        CLEANUP_INSTANCE_EXISTS=true
        os::aws lightsail "$op" "${args[@]}" || rc=$?
        (( rc == 0 )) || os::die "$EX_AWS" "$op failed: $AWS_ERR"
        CREATE_CREATED=true
        os::op_wait "$AWS_OUT"
    fi
    os::out created "$CREATE_CREATED"
    os::out reused "$CREATE_REUSED"
    [[ -n $RUN_PHASE ]] && RUN_PHASE="wait"
    if [[ $OPT_WAIT == true || $OPT_WAIT_SSH == true ]]; then
        os::state_wait "$name" running "$OPT_CREATE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$name' did not reach 'running' within ${OPT_CREATE_TIMEOUT}s"
    fi
    if (( ${#OPT_OPEN_PORTS[@]} )); then
        os::ports_apply "$name" open "${OPT_OPEN_PORTS[@]}"
    fi
    if [[ $OPT_STATIC_IP == true ]]; then
        ipname="octosail-$name"
        os::static_ip_ensure "$name" "$ipname" true
        if [[ $CREATE_REUSED == true ]]; then
            os::instance_tags_set "$name" "$(os::json_tags "$TAG_STATIC_IP=$ipname")"
        fi
    elif [[ -n $OPT_STATIC_IP_NAME ]]; then
        os::static_ip_ensure "$name" "$OPT_STATIC_IP_NAME" false
    fi
    if [[ $DRY_RUN != true ]]; then
        os::instance_get "$name" || os::die "$EX_NOTFOUND" "instance '$name' disappeared"
    else
        INST_NAME=$name
        INST_STATE=${INST_STATE:-running}
        INST_AZ=$OPT_AZ
        INST_BLUEPRINT=$OPT_BLUEPRINT
        INST_BUNDLE=$OPT_BUNDLE
    fi
    if [[ $INST_STATE == running && -n $INST_PUBLIC_IP ]]; then
        os::notice "instance '$name' is running at $INST_PUBLIC_IP"
    fi
    os::instance_outputs
    if [[ $OPT_WAIT_SSH == true && $INST_STATE == running ]]; then
        [[ -n $RUN_PHASE ]] && RUN_PHASE="ssh"
        os::ssh_wait "$name" "$OPT_SSH_TIMEOUT" "$EX_TIMEOUT"
        os::out ssh_ready true
        local ci=$OPT_CLOUD_INIT_WAIT
        if [[ $ci == auto ]]; then
            if [[ $OPT_USER_DATA_GIVEN == true ]]; then
                ci=true
            else
                ci=false
            fi
        fi
        if [[ $ci == true ]]; then
            [[ -n $RUN_PHASE ]] && RUN_PHASE="cloud-init"
            rc=0
            os::cloud_init_wait "$name" "$OPT_CLOUD_INIT_TIMEOUT" || rc=$?
            os::out cloud_init_status "$CLOUD_INIT_STATUS"
            case $rc in
                0) ;;
                "$EX_CLOUDINIT") os::die "$EX_CLOUDINIT" "cloud-init on '$name' finished with status '$CLOUD_INIT_STATUS'" ;;
                "$EX_TIMEOUT") os::die "$EX_TIMEOUT" "cloud-init on '$name' did not finish within ${OPT_CLOUD_INIT_TIMEOUT}s" ;;
                *) os::die "$rc" "cloud-init wait failed" ;;
            esac
        fi
    else
        os::out ssh_ready false
    fi
    return 0
}

cmd_create() {
    os::parse_create_args "$@"
    os::resolve_name
    os::region_resolve
    os::create_flow "$OPT_NAME"
    os::instance_table
    os::kv "created" "$CREATE_CREATED"
    os::kv "reused" "$CREATE_REUSED"
    os::kv "ssh ready" "$(os::out_get ssh_ready)"
    os::kv "cloud-init" "$(os::out_get cloud_init_status)"
    return 0
}

###############################################################################
# delete
###############################################################################

cmd_delete() {
    os::parse_delete_args "$@"
    os::resolve_name
    os::region_resolve
    if [[ $DRY_RUN == true ]]; then
        os::info "DRY-RUN: no resource will be deleted"
    fi
    os::delete_flow "$OPT_NAME"
    os::kv "name" "$OPT_NAME"
    os::kv "deleted" "$(os::out_get deleted)"
    [[ -n $(os::out_get snapshot_name) ]] && os::kv "snapshot" "$(os::out_get snapshot_name)"
    return 0
}

###############################################################################
# exec
###############################################################################

EXEC_TIMED_OUT=false

# os::exec_flow NAME - run the script exactly once; sets REMOTE_EXIT / EXEC_DURATION and returns the remote status.
# When the watchdog killed the script, EXEC_TIMED_OUT is true and the status is 124.
os::exec_flow() {
    local name=$1 body="$RUN_DIR/body.sh" script="$RUN_DIR/remote.sh" capture rc=0 start kv key stdout_val
    os::out_declare name remote_exit_code duration_seconds public_ip username stdout_file stderr_file stdout stdout_truncated
    os::out name "$name"
    for kv in "${OPT_ENV[@]+"${OPT_ENV[@]}"}"; do
        key=${kv%%=*}
        [[ $kv == *=* ]] || os::die "$EX_USAGE" "--env '$kv' must be NAME=VALUE"
        os::validate_env_name "$key"
    done
    if [[ $SCRIPT_PREPARED != true ]]; then
        os::script_load "$body"
        os::ssh_build_script "$body" "$script"
        SCRIPT_PREPARED=true
    fi
    if [[ $SSH_READY != true ]]; then
        os::ssh_wait "$name" "$OPT_SSH_TIMEOUT" "$EX_SSH"
    fi
    capture=$(os::capture_dir "$name")
    os::out public_ip "$SSH_HOST"
    os::out username "$SSH_USER"
    os::info "executing script ($OPT_SCRIPT_SOURCE) on $SSH_USER@$SSH_HOST as $OPT_SHELL$([[ $OPT_SUDO == true ]] && printf ' with sudo')"
    start=$SECONDS
    os::ssh_run_script "$name" "$script" "$OPT_EXEC_TIMEOUT" "$capture" || rc=$?
    EXEC_DURATION=$((SECONDS - start))
    os::out duration_seconds "$EXEC_DURATION"
    EXEC_TIMED_OUT=$TIMED_OUT
    if [[ $EXEC_TIMED_OUT == true ]]; then
        [[ $TIMEOUT_REASON == global ]] && os::die "$EX_TIMEOUT" "global timeout of ${GLOBAL_TIMEOUT}s exceeded while the remote script was running"
        rc=124
        REMOTE_EXIT=""
        os::out remote_exit_code ""
    else
        REMOTE_EXIT=$rc
        os::out remote_exit_code "$rc"
    fi
    if [[ -n $capture && -f $capture/stdout.log ]]; then
        os::out stdout_file "$capture/stdout.log"
        os::out stderr_file "$capture/stderr.log"
        stdout_val=$(head -c "$OUTPUT_MAX_BYTES" "$capture/stdout.log")
        os::out stdout "$stdout_val"
        if (( $(wc -c <"$capture/stdout.log") > OUTPUT_MAX_BYTES )); then
            os::out stdout_truncated true
        else
            os::out stdout_truncated false
        fi
    fi
    if (( rc == 0 )); then
        os::info "remote script finished successfully in ${EXEC_DURATION}s"
    elif [[ $EXEC_TIMED_OUT == true ]]; then
        os::error "remote script killed after ${OPT_EXEC_TIMEOUT}s (--exec-timeout)"
    else
        os::warn "remote script exited with status $rc after ${EXEC_DURATION}s"
    fi
    return "$rc"
}

# os::exec_exit RC - map a remote status to the process exit code.
os::exec_exit() {
    local rc=$1
    if [[ $EXEC_TIMED_OUT == true ]]; then
        os::die "$EX_TIMEOUT" "remote script timed out after ${OPT_EXEC_TIMEOUT}s"
    fi
    case $rc in
        0) return 0 ;;
        255) os::die "$EX_SSH" "ssh transport failure while running the remote script" ;;
    esac
    if [[ $OPT_PASSTHROUGH == true ]]; then
        REMOTE_PASSTHROUGH=true
        EXIT_CODE=$rc
        os::error "remote script exited with status $rc"
        exit "$rc"
    fi
    os::die "$EX_REMOTE" "remote script exited with status $rc"
}

cmd_exec() {
    local rc=0
    os::parse_exec_args "$@"
    os::resolve_name
    os::out_declare name remote_exit_code duration_seconds public_ip username stdout_file stderr_file stdout stdout_truncated
    os::out name "$OPT_NAME"
    os::region_resolve
    os::ensure_running "$OPT_NAME"
    os::exec_flow "$OPT_NAME" || rc=$?
    os::exec_exit "$rc"
}

###############################################################################
# copy
###############################################################################

cmd_copy() {
    local dest="" arg remote_dest=false remote_src=0 local_src=0 rc=0
    local -a sources=() scp_args=()
    os::parse_copy_args "$@"
    if (( ${#POSITIONALS[@]} == 0 )) && [[ -n ${OCTOSAIL_COPY_SOURCE:-} ]]; then
        os::split_lines "$OCTOSAIL_COPY_SOURCE" POSITIONALS
        [[ -n ${OCTOSAIL_COPY_DESTINATION:-} ]] && POSITIONALS+=("$OCTOSAIL_COPY_DESTINATION")
    fi
    if [[ -z $OPT_NAME ]] && (( ${#POSITIONALS[@]} >= 3 )) && [[ ${POSITIONALS[0]} != remote:* && ${POSITIONALS[0]} =~ $NAME_RE && ! -e ${POSITIONALS[0]} ]]; then
        OPT_NAME=${POSITIONALS[0]}
        POSITIONALS=("${POSITIONALS[@]:1}")
    fi
    os::resolve_name
    os::out_declare name copied_files
    os::out name "$OPT_NAME"
    os::region_resolve
    (( ${#POSITIONALS[@]} >= 2 )) || os::die "$EX_USAGE" "copy needs at least one SRC and a DEST (remote paths are written remote:PATH)"
    dest=${POSITIONALS[${#POSITIONALS[@]}-1]}
    sources=("${POSITIONALS[@]:0:${#POSITIONALS[@]}-1}")
    [[ $dest == remote:* ]] && remote_dest=true
    for arg in "${sources[@]}"; do
        if [[ $arg == remote:* ]]; then
            remote_src=$((remote_src + 1))
        else
            local_src=$((local_src + 1))
        fi
    done
    if [[ $remote_dest == true ]]; then
        (( remote_src == 0 )) || os::die "$EX_USAGE" "when DEST is remote every SRC must be local"
    else
        (( local_src == 0 && remote_src > 0 )) || os::die "$EX_USAGE" "exactly one side must be remote (prefix remote paths with remote:)"
    fi
    os::ensure_running "$OPT_NAME"
    os::ssh_wait "$OPT_NAME" "$OPT_SSH_TIMEOUT" "$EX_SSH"
    [[ $OPT_COPY_RECURSIVE == true ]] && scp_args+=(-r)
    for arg in "${sources[@]}"; do
        if [[ $arg == remote:* ]]; then
            scp_args+=("$(os::remote_path "${arg#remote:}")")
        else
            [[ -e $arg ]] || os::die "$EX_USAGE" "local source '$arg' does not exist"
            scp_args+=("$arg")
        fi
    done
    if [[ $remote_dest == true ]]; then
        scp_args+=("$(os::remote_path "${dest#remote:}")")
    else
        scp_args+=("$dest")
    fi
    os::out_declare name copied_files
    os::out name "$OPT_NAME"
    os::info "copying ${#sources[@]} item(s) $([[ $remote_dest == true ]] && printf 'to' || printf 'from') $SSH_USER@$SSH_HOST"
    os::scp "$OPT_NAME" "${scp_args[@]}" || rc=$?
    (( rc == 0 )) || os::die "$EX_SSH" "scp failed with status $rc"
    os::out copied_files "${#sources[@]}"
    os::kv "name" "$OPT_NAME"
    os::kv "copied" "${#sources[@]}"
    return 0
}

###############################################################################
# start / stop / reboot
###############################################################################

os::power_outputs() {
    os::out_declare name state changed public_ip
    os::out name "$INST_NAME"
    os::out state "$INST_STATE"
    os::out public_ip "$INST_PUBLIC_IP"
    JSON_INSTANCE=$INST_JSON
}

cmd_start() {
    local rc=0 changed=false
    os::parse_power_args start "$@"
    os::resolve_name
    os::out_declare name state changed public_ip
    os::out name "$OPT_NAME"
    os::region_resolve
    os::instance_get "$OPT_NAME" || rc=$?
    (( rc == EX_NOTFOUND )) && os::die "$EX_NOTFOUND" "instance '$OPT_NAME' does not exist"
    case $INST_STATE in
        running) os::info "instance '$OPT_NAME' is already running" ;;
        pending|starting|rebooting) os::info "instance '$OPT_NAME' is $INST_STATE" ;;
        *)
            os::info "starting instance '$OPT_NAME'"
            os::aws_must lightsail start-instance --instance-name "$OPT_NAME"
            os::op_wait "$AWS_OUT"
            changed=true
            ;;
    esac
    if [[ $OPT_WAIT == true || $OPT_WAIT_SSH == true ]] && [[ $INST_STATE != running ]]; then
        os::state_wait "$OPT_NAME" running "$OPT_STATE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$OPT_NAME' did not reach 'running' within ${OPT_STATE_TIMEOUT}s"
    fi
    [[ $changed == true && $DRY_RUN != true ]] && { os::instance_get "$OPT_NAME" || true; }
    if [[ $OPT_WAIT_SSH == true ]]; then
        os::ssh_wait "$OPT_NAME" "$OPT_SSH_TIMEOUT" "$EX_TIMEOUT"
    fi
    os::power_outputs
    os::out changed "$changed"
    os::kv "name" "$INST_NAME"
    os::kv "state" "$INST_STATE"
    os::kv "changed" "$changed"
    os::kv "public ip" "$INST_PUBLIC_IP"
    return 0
}

cmd_stop() {
    local rc=0 changed=false
    local -a args=()
    os::parse_power_args stop "$@"
    os::resolve_name
    os::out_declare name state changed public_ip
    os::out name "$OPT_NAME"
    os::region_resolve
    os::instance_get "$OPT_NAME" || rc=$?
    (( rc == EX_NOTFOUND )) && os::die "$EX_NOTFOUND" "instance '$OPT_NAME' does not exist"
    case $INST_STATE in
        stopped) os::info "instance '$OPT_NAME' is already stopped" ;;
        stopping) os::info "instance '$OPT_NAME' is already stopping" ;;
        *)
            [[ $OPT_FORCE_STOP == true ]] && args+=(--force)
            os::info "stopping instance '$OPT_NAME'$([[ $OPT_FORCE_STOP == true ]] && printf ' (forced)')"
            os::aws_must lightsail stop-instance --instance-name "$OPT_NAME" "${args[@]+"${args[@]}"}"
            os::op_wait "$AWS_OUT"
            changed=true
            ;;
    esac
    if [[ $OPT_WAIT == true && $INST_STATE != stopped ]]; then
        os::state_wait "$OPT_NAME" stopped "$OPT_STATE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$OPT_NAME' did not reach 'stopped' within ${OPT_STATE_TIMEOUT}s"
    fi
    [[ $changed == true && $DRY_RUN != true ]] && { os::instance_get "$OPT_NAME" || true; }
    os::power_outputs
    os::out changed "$changed"
    os::kv "name" "$INST_NAME"
    os::kv "state" "$INST_STATE"
    os::kv "changed" "$changed"
    return 0
}

cmd_reboot() {
    local rc=0 changed=true boot_before="" boot_after="" deadline attempts=0 max_attempts interval
    os::parse_power_args reboot "$@"
    os::resolve_name
    os::out_declare name state changed public_ip
    os::out name "$OPT_NAME"
    os::region_resolve
    os::instance_get "$OPT_NAME" || rc=$?
    (( rc == EX_NOTFOUND )) && os::die "$EX_NOTFOUND" "instance '$OPT_NAME' does not exist"
    if [[ $INST_STATE == stopped ]]; then
        os::warn "instance '$OPT_NAME' is stopped; a reboot is treated as start"
        os::aws_must lightsail start-instance --instance-name "$OPT_NAME"
        os::op_wait "$AWS_OUT"
    elif [[ $OPT_HARD == true ]]; then
        os::info "hard reboot: stopping instance '$OPT_NAME'"
        if [[ $INST_STATE != stopping ]]; then
            os::aws_must lightsail stop-instance --instance-name "$OPT_NAME"
            os::op_wait "$AWS_OUT"
        fi
        os::state_wait "$OPT_NAME" stopped "$OPT_STATE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$OPT_NAME' did not stop within ${OPT_STATE_TIMEOUT}s"
        os::info "hard reboot: starting instance '$OPT_NAME'"
        os::aws_must lightsail start-instance --instance-name "$OPT_NAME"
        os::op_wait "$AWS_OUT"
    else
        if [[ $OPT_WAIT_SSH == true && $INST_STATE == running && $DRY_RUN != true ]]; then
            boot_before=$(
                os::ssh_wait "$OPT_NAME" "$OPT_SSH_TIMEOUT" "$EX_TIMEOUT" 2>/dev/null
                os::ssh_boot_id "$OPT_NAME" 2>/dev/null
                printf '%s' "$BOOT_ID"
            ) || boot_before=""
            if [[ -n $boot_before ]]; then
                os::info "recorded the boot id of '$OPT_NAME' before the reboot"
            else
                os::warn "could not read the boot id before the reboot (SSH not reachable); falling back to a plain readiness probe"
            fi
        fi
        os::info "rebooting instance '$OPT_NAME'"
        os::aws_must lightsail reboot-instance --instance-name "$OPT_NAME"
        os::op_wait "$AWS_OUT"
    fi
    if [[ $OPT_WAIT == true || $OPT_WAIT_SSH == true ]]; then
        os::state_wait "$OPT_NAME" running "$OPT_STATE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$OPT_NAME' did not reach 'running' within ${OPT_STATE_TIMEOUT}s"
    fi
    [[ $DRY_RUN != true ]] && { os::instance_get "$OPT_NAME" || true; }
    if [[ $OPT_WAIT_SSH == true && $DRY_RUN != true ]]; then
        SSH_READY=false
        ACCESS_JSON=""
        os::ssh_wait "$OPT_NAME" "$OPT_SSH_TIMEOUT" "$EX_TIMEOUT"
        if [[ -n $boot_before ]]; then
            deadline=$((SECONDS + OPT_SSH_TIMEOUT))
            max_attempts=$(os::max_attempts "$OPT_SSH_TIMEOUT")
            interval=5
            while :; do
                os::ssh_boot_id "$OPT_NAME"
                boot_after=$BOOT_ID
                if [[ -n $boot_after && $boot_after != "$boot_before" ]]; then
                    os::info "instance '$OPT_NAME' came back with a new boot id"
                    break
                fi
                attempts=$((attempts + 1))
                if (( SECONDS >= deadline || attempts >= max_attempts )); then
                    os::die "$EX_TIMEOUT" "instance '$OPT_NAME' did not report a new boot id within ${OPT_SSH_TIMEOUT}s"
                fi
                os::sleep "$interval"
                interval=$(os::backoff "$interval" 20)
            done
        fi
    fi
    os::power_outputs
    os::out changed "$changed"
    os::kv "name" "$INST_NAME"
    os::kv "state" "$INST_STATE"
    os::kv "public ip" "$INST_PUBLIC_IP"
    return 0
}

###############################################################################
# status
###############################################################################

cmd_status() {
    local rc=0
    os::parse_status_args "$@"
    os::resolve_name
    os::region_resolve
    os::out_declare exists name state public_ip private_ip ipv6_addresses username region availability_zone \
        blueprint_id bundle_id arn key_pair_name static_ip_name expires_at
    os::out name "$OPT_NAME"
    os::instance_get "$OPT_NAME" || rc=$?
    if (( rc == EX_NOTFOUND )); then
        os::out exists false
        if [[ $OPT_IF_MISSING == fail ]]; then
            os::die "$EX_NOTFOUND" "instance '$OPT_NAME' does not exist"
        fi
        os::kv "name" "$OPT_NAME"
        os::kv "exists" "false"
        return 0
    fi
    os::out exists true
    os::instance_outputs
    os::instance_table
    os::kv "ports" "$(os::port_summary "$INST_JSON")"
    os::kv "tags" "$(jq -r '[(.tags // [])[] | .key + "=" + (.value // "")] | join(", ")' <<<"$INST_JSON")"
    return 0
}

###############################################################################
# wait
###############################################################################

cmd_wait() {
    local cond rc=0
    os::parse_wait_args "$@"
    os::resolve_name
    os::region_resolve
    (( ${#OPT_WAIT_FOR[@]} )) || os::die "$EX_USAGE" "wait needs at least one --for CONDITION (running, stopped, terminated, absent, ssh, cloud-init, operation:ID)"
    os::out_declare name condition state public_ip cloud_init_status
    os::out name "$OPT_NAME"
    if [[ ${OPT_WAIT_FOR[0]} != absent ]]; then
        os::instance_get "$OPT_NAME" || rc=$?
        (( rc == EX_NOTFOUND )) && os::die "$EX_NOTFOUND" "instance '$OPT_NAME' does not exist"
    fi
    for cond in "${OPT_WAIT_FOR[@]}"; do
        os::out condition "$cond"
        os::info "waiting for '$OPT_NAME': $cond (up to ${OPT_WAIT_TIMEOUT}s)"
        case $cond in
            running|stopped|terminated)
                os::state_wait "$OPT_NAME" "$cond" "$OPT_WAIT_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$OPT_NAME' did not reach '$cond' within ${OPT_WAIT_TIMEOUT}s"
                ;;
            absent)
                os::absent_wait "$OPT_NAME" "$OPT_WAIT_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$OPT_NAME' still exists after ${OPT_WAIT_TIMEOUT}s"
                INST_STATE=absent
                ;;
            ssh)
                os::ensure_running "$OPT_NAME"
                SSH_READY=false
                os::ssh_wait "$OPT_NAME" "$OPT_WAIT_TIMEOUT" "$EX_TIMEOUT"
                ;;
            cloud-init)
                os::ensure_running "$OPT_NAME"
                [[ $SSH_READY == true ]] || os::ssh_wait "$OPT_NAME" "$OPT_SSH_TIMEOUT" "$EX_TIMEOUT"
                rc=0
                os::cloud_init_wait "$OPT_NAME" "$OPT_WAIT_TIMEOUT" || rc=$?
                os::out cloud_init_status "$CLOUD_INIT_STATUS"
                case $rc in
                    0) ;;
                    "$EX_CLOUDINIT") os::die "$EX_CLOUDINIT" "cloud-init on '$OPT_NAME' finished with status '$CLOUD_INIT_STATUS'" ;;
                    *) os::die "$EX_TIMEOUT" "cloud-init on '$OPT_NAME' did not finish within ${OPT_WAIT_TIMEOUT}s" ;;
                esac
                ;;
            operation:*)
                os::op_wait "$(jq -cn --arg id "${cond#operation:}" '{operations: [{id: $id, status: "Started", isTerminal: false}]}')" "$OPT_WAIT_TIMEOUT"
                ;;
            *) os::die "$EX_USAGE" "unknown wait condition '$cond'" ;;
        esac
        os::info "condition '$cond' satisfied"
    done
    if [[ $INST_STATE != absent ]]; then
        os::instance_get "$OPT_NAME" || true
    fi
    os::out state "$INST_STATE"
    os::out public_ip "$INST_PUBLIC_IP"
    JSON_INSTANCE=$INST_JSON
    os::kv "name" "$OPT_NAME"
    os::kv "state" "$INST_STATE"
    return 0
}

###############################################################################
# ports
###############################################################################

cmd_ports() {
    local rc=0 modifiers=0
    os::parse_ports_args "$@"
    os::resolve_name
    os::region_resolve
    (( ${#OPT_PORTS_OPEN[@]} )) && modifiers=$((modifiers + 1))
    (( ${#OPT_PORTS_CLOSE[@]} )) && modifiers=$((modifiers + 1))
    if (( ${#OPT_PORTS_SET[@]} )) && (( modifiers > 0 )); then
        os::die "$EX_USAGE" "--set cannot be combined with --open or --close"
    fi
    os::out_declare name ports
    os::out name "$OPT_NAME"
    local spec
    for spec in "${OPT_PORTS_SET[@]+"${OPT_PORTS_SET[@]}"}" "${OPT_PORTS_OPEN[@]+"${OPT_PORTS_OPEN[@]}"}" "${OPT_PORTS_CLOSE[@]+"${OPT_PORTS_CLOSE[@]}"}"; do
        os::parse_port_spec "$spec"
    done
    os::instance_get "$OPT_NAME" || rc=$?
    (( rc == EX_NOTFOUND )) && os::die "$EX_NOTFOUND" "instance '$OPT_NAME' does not exist"
    if (( ${#OPT_PORTS_SET[@]} )); then
        os::ports_apply "$OPT_NAME" set "${OPT_PORTS_SET[@]}"
    fi
    if (( ${#OPT_PORTS_OPEN[@]} )); then
        os::ports_apply "$OPT_NAME" open "${OPT_PORTS_OPEN[@]}"
    fi
    if (( ${#OPT_PORTS_CLOSE[@]} )); then
        os::ports_apply "$OPT_NAME" close "${OPT_PORTS_CLOSE[@]}"
    fi
    if (( modifiers > 0 || ${#OPT_PORTS_SET[@]} > 0 )) && [[ $DRY_RUN != true ]]; then
        os::instance_get "$OPT_NAME" || true
    fi
    os::out ports "$(os::port_summary "$INST_JSON")"
    JSON_INSTANCE=$INST_JSON
    if [[ $JSON_MODE != true ]]; then
        printf '%-12s %-8s %-24s %s\n' "PORTS" "PROTO" "CIDRS" "IPV6_CIDRS"
        jq -r '(.networking.ports // [])[] | [
            (if .fromPort == .toPort then (.fromPort|tostring) else ((.fromPort|tostring) + "-" + (.toPort|tostring)) end),
            (.protocol|ascii_downcase), ((.cidrs // []) | join(",")), ((.ipv6Cidrs // []) | join(","))] | join("\u001f")' <<<"$INST_JSON" \
            | while IFS=$'\x1f' read -r p pr c6 c4; do printf '%-12s %-8s %-24s %s\n' "$p" "$pr" "${c6:--}" "${c4:--}"; done
    fi
    return 0
}

###############################################################################
# list
###############################################################################

# os::list_instances - AWS_OUT becomes the JSON array of all instances in the region.
os::list_instances() {
    os::aws_paginate lightsail get-instances instances || os::die "$EX_AWS" "get-instances failed: $AWS_ERR"
}

# os::filter_instances JSON MANAGED EXPIRED RUN_ID NOW - jq filter for list/gc.
os::filter_instances() {
    local json=$1 managed=$2 expired=$3 run_id=$4 now=$5
    jq -c --arg managed "$managed" --arg expired "$expired" --arg run_id "$run_id" --arg now "$now" \
        --arg tm "$TAG_MANAGED" --arg te "$TAG_EXPIRES" --arg tr "$TAG_RUN_ID" '
        def tag($k): ([(.tags // [])[] | select(.key == $k) | .value] | first // "");
        map(select(
            ($managed != "true" or tag($tm) == "true")
            and ($expired != "true" or (tag($te) != "" and tag($te) < $now))
            and ($run_id == "" or tag($tr) == $run_id)
        ))' <<<"$json"
}

cmd_list() {
    local filtered names count
    os::parse_list_args "$@"
    os::region_resolve
    os::out_declare count names
    os::list_instances
    filtered=$(os::filter_instances "$AWS_OUT" "$OPT_MANAGED" "$OPT_EXPIRED" "$OPT_RUN_ID" "$(os::now_iso)")
    count=$(jq -r 'length' <<<"$filtered")
    names=$(jq -r 'map(.name) | join(",")' <<<"$filtered")
    os::out count "$count"
    os::out names "$names"
    JSON_INSTANCE=$filtered
    if [[ $JSON_MODE == true ]]; then
        return 0
    fi
    if [[ $OPT_NAMES == true ]]; then
        jq -r '.[] | .name' <<<"$filtered"
        return 0
    fi
    printf '%-32s %-14s %-16s %-14s %-14s %-8s %s\n' "NAME" "STATE" "PUBLIC_IP" "BUNDLE" "AZ" "MANAGED" "EXPIRES_AT"
    jq -r --arg tm "$TAG_MANAGED" --arg te "$TAG_EXPIRES" '
        def tag($k): ([(.tags // [])[] | select(.key == $k) | .value] | first // "");
        .[] | [.name, (.state.name // ""), (.publicIpAddress // ""), (.bundleId // ""), (.location.availabilityZone // ""),
               (if tag($tm) == "true" then "yes" else "no" end), tag($te)] | join("\u001f")' <<<"$filtered" \
        | while IFS=$'\x1f' read -r n s ip b az m e; do printf '%-32s %-14s %-16s %-14s %-14s %-8s %s\n' "$n" "$s" "${ip:--}" "$b" "$az" "$m" "${e:--}"; done
    return 0
}

###############################################################################
# gc
###############################################################################

cmd_gc() {
    local candidates now cutoff="" name rc deleted=0 failed=0
    local -a deleted_names=() failed_names=()
    os::parse_gc_args "$@"
    os::region_resolve
    os::out_declare deleted_count deleted_names failed_names dry_run
    os::out dry_run "$DRY_RUN"
    if [[ $OPT_ALL_MANAGED == true && $ASSUME_YES != true ]]; then
        os::die "$EX_REFUSED" "gc --all-managed deletes every managed instance in $REGION; confirm with --yes"
    fi
    now=$(os::now_iso)
    if [[ -n $OPT_OLDER_THAN ]]; then
        os::to_seconds "$OPT_OLDER_THAN" "--older-than"
        cutoff=$(os::epoch_to_iso $(( $(os::now_epoch) - SECS )))
    fi
    os::list_instances
    candidates=$(jq -c --arg now "$now" --arg cutoff "$cutoff" --arg run_id "$OPT_RUN_ID" --arg all "$OPT_ALL_MANAGED" \
        --arg tm "$TAG_MANAGED" --arg te "$TAG_EXPIRES" --arg tr "$TAG_RUN_ID" --arg tp "$TAG_PROTECTED" '
        def tag($k): ([(.tags // [])[] | select(.key == $k) | .value] | first // "");
        map(select(tag($tm) == "true" and tag($tp) != "true"))
        | map(select($run_id == "" or tag($tr) == $run_id))
        | map(select(
            $all == "true"
            or (tag($te) != "" and tag($te) < $now)
            or ($cutoff != "" and (.createdAt // "") != "" and (.createdAt | .[0:19]) < ($cutoff | .[0:19]))
          ))
        | map(.name)' <<<"$AWS_OUT")
    if [[ $(jq -r 'length' <<<"$candidates") -eq 0 ]]; then
        os::info "gc: nothing to reclaim in $REGION"
        os::out deleted_count 0
        os::kv "deleted" "0"
        return 0
    fi
    while IFS= read -r name; do
        [[ -n $name ]] || continue
        rc=0
        os::group "gc: delete $name"
        (
            OPT_IF_MISSING=ok
            OPT_SNAPSHOT_FIRST=""
            os::delete_flow "$name"
        ) || rc=$?
        os::endgroup
        if (( rc == 0 )); then
            deleted=$((deleted + 1))
            deleted_names+=("$name")
        else
            failed=$((failed + 1))
            failed_names+=("$name")
            os::error "gc: could not delete '$name' (exit $rc)"
        fi
    done < <(jq -r '.[]' <<<"$candidates")
    os::out deleted_count "$deleted"
    os::out deleted_names "$(IFS=,; printf '%s' "${deleted_names[*]+"${deleted_names[*]}"}")"
    os::out failed_names "$(IFS=,; printf '%s' "${failed_names[*]+"${failed_names[*]}"}")"
    os::kv "deleted" "$deleted"
    os::kv "failed" "$failed"
    if (( failed > 0 )); then
        os::die "$EX_CLEANUP" "gc: $failed instance(s) could not be deleted: ${failed_names[*]}"
    fi
    return 0
}

###############################################################################
# doctor
###############################################################################

cmd_doctor() {
    local ok=true cmd ver account rc=0
    os::parse_doctor_args "$@"
    os::out_declare ok aws_account region
    printf '%-14s %s\n' "bash" "ok (${BASH_VERSION})"
    for cmd in jq ssh scp ssh-keygen curl; do
        if os::has_cmd "$cmd"; then
            printf '%-14s %s\n' "$cmd" "ok ($(command -v "$cmd"))"
        else
            printf '%-14s %s\n' "$cmd" "MISSING"
            ok=false
        fi
    done
    if os::has_cmd "$AWS_BIN"; then
        ver=$("$AWS_BIN" --version 2>&1 </dev/null | head -n1) || ver=""
        if [[ $ver == aws-cli/2* ]]; then
            printf '%-14s %s\n' "aws" "ok ($ver)"
        elif [[ $ver == aws-cli/1* ]]; then
            printf '%-14s %s\n' "aws" "UNSUPPORTED ($ver; install AWS CLI v2)"
            ok=false
        else
            printf '%-14s %s\n' "aws" "ok (${ver:-version unknown})"
        fi
    else
        printf '%-14s %s\n' "aws" "MISSING"
        ok=false
    fi
    if [[ -n $CONFIG_FILE ]]; then
        printf '%-14s %s\n' "config" "$CONFIG_FILE"
    else
        printf '%-14s %s\n' "config" "none"
    fi
    if [[ -d $RUN_DIR && -w $RUN_DIR ]]; then
        printf '%-14s %s\n' "temp dir" "ok ($TMP_PARENT)"
    else
        printf '%-14s %s\n' "temp dir" "NOT WRITABLE ($TMP_PARENT)"
        ok=false
    fi
    REGION=${REGION:-${OCTOSAIL_REGION:-${AWS_REGION:-${AWS_DEFAULT_REGION:-}}}}
    if [[ -z $REGION ]] && os::has_cmd "$AWS_BIN"; then
        REGION=$("$AWS_BIN" configure get region 2>/dev/null </dev/null) || REGION=""
    fi
    if [[ -n $REGION ]]; then
        printf '%-14s %s\n' "region" "$REGION"
    elif [[ $OPT_OFFLINE == true ]]; then
        printf '%-14s %s\n' "region" "not configured yet (set --region, OCTOSAIL_REGION or AWS_REGION before running commands)"
    else
        printf '%-14s %s\n' "region" "NOT CONFIGURED (use --region, OCTOSAIL_REGION or AWS_REGION)"
        ok=false
    fi
    os::out region "$REGION"
    if [[ $OPT_OFFLINE == true ]]; then
        printf '%-14s %s\n' "credentials" "skipped (--offline)"
    elif [[ $ok == true ]]; then
        local ident=""
        ident=$(
            if os::aws sts get-caller-identity; then
                printf '%s' "$AWS_OUT"
            else
                printf 'ERROR:%s' "$AWS_ERR"
                exit 1
            fi
        ) || rc=$?
        if (( rc == 0 )) && [[ -n $ident ]]; then
            account=$(jq -r '.Account // empty' <<<"$ident")
            os::mask "$account"
            os::out aws_account "$account"
            printf '%-14s %s\n' "credentials" "ok (account $account, $(jq -r '.Arn // "unknown"' <<<"$ident"))"
        else
            printf '%-14s %s\n' "credentials" "FAILED (${ident#ERROR:}${ident:+ }see the error above)"
            ok=false
        fi
    else
        printf '%-14s %s\n' "credentials" "skipped (fix the problems above first)"
    fi
    os::out ok "$ok"
    if [[ $ok != true ]]; then
        if [[ -z $REGION && $OPT_OFFLINE != true ]]; then
            os::die "$EX_AUTH" "doctor found problems (see above)"
        fi
        if os::has_cmd "$AWS_BIN" && os::has_cmd jq && os::has_cmd ssh && os::has_cmd scp && os::has_cmd ssh-keygen && os::has_cmd curl; then
            os::die "$EX_AUTH" "doctor found problems (see above)"
        fi
        os::die "$EX_DEP" "doctor found problems (see above)"
    fi
    printf '%-14s %s\n' "result" "all checks passed"
    return 0
}

###############################################################################
# action (GitHub Actions dispatcher), help, version
###############################################################################

cmd_action() {
    local command=${OCTOSAIL_COMMAND:-} word
    local -a extra=()
    (( $# == 0 )) || os::die "$EX_USAGE" "'octosail action' takes no arguments; use OCTOSAIL_COMMAND and OCTOSAIL_EXTRA_ARGS"
    [[ -n $command ]] || os::die "$EX_USAGE" "OCTOSAIL_COMMAND is not set"
    for word in $COMMANDS; do
        if [[ $word == "$command" && $word != action ]]; then
            os::split_lines "${OCTOSAIL_EXTRA_ARGS:-}" extra
            os::info "action: $(os::pretty_argv octosail "$command" "${extra[@]+"${extra[@]}"}")"
            os::dispatch "$command" "${extra[@]+"${extra[@]}"}"
            return $?
        fi
    done
    os::die "$EX_USAGE" "OCTOSAIL_COMMAND '$command' is not a valid command (${COMMANDS// / })"
}

cmd_help() {
    local topic=""
    while (( $# )); do
        os::opt_split "$@"
        case $OPT_FLAG in
            -*) os::parse_opt_global || os::die "$EX_USAGE" "unknown option '$OPT_FLAG' for help" ;;
            *) topic=$1; OPT_SHIFT=1 ;;
        esac
        shift "$OPT_SHIFT"
    done
    if [[ -n $topic ]]; then
        topic=${topic#--}
        if os::is_command "$topic" && [[ $topic != help ]]; then
            "usage_$topic"
            return 0
        fi
        os::die "$EX_USAGE" "no help for '$topic'"
    fi
    usage_main
    return 0
}

# shellcheck disable=SC2120 # arguments are optional
cmd_version() {
    while (( $# )); do
        os::opt_split "$@"
        case $OPT_FLAG in
            -*) os::parse_opt_global || os::die "$EX_USAGE" "unknown option '$OPT_FLAG' for version" ;;
            *) os::die "$EX_USAGE" "version takes no argument" ;;
        esac
        shift "$OPT_SHIFT"
    done
    if [[ $JSON_MODE == true ]]; then
        JSON_MODE=false
        printf '{"name":"octosail","version":"%s"}\n' "$_VERSION"
    else
        printf 'octosail %s\n' "$_VERSION"
    fi
    return 0
}

###############################################################################
# run: create -> wait -> upload -> exec -> download -> delete (guaranteed cleanup)
###############################################################################

cmd_run() {
    local rc=0 spec key kv
    os::parse_run_args "$@"
    RUN_PHASE=validate
    os::resolve_name
    os::region_resolve
    os::out_declare name created reused state public_ip private_ip ipv6_addresses username region availability_zone \
        blueprint_id bundle_id arn key_pair_name static_ip_name expires_at ssh_ready cloud_init_status \
        remote_exit_code duration_seconds stdout_file stderr_file stdout stdout_truncated deleted phase_failed \
        leaked_instance cleanup_error
    os::out name "$OPT_NAME"
    case $OPT_DELETE_POLICY in
        created|always|never) ;;
        *) os::die "$EX_USAGE" "--delete-policy must be created, always or never (got '$OPT_DELETE_POLICY')" ;;
    esac
    for kv in "${OPT_ENV[@]+"${OPT_ENV[@]}"}"; do
        key=${kv%%=*}
        [[ $kv == *=* ]] || os::die "$EX_USAGE" "--env '$kv' must be NAME=VALUE"
        os::validate_env_name "$key"
    done
    os::script_load "$RUN_DIR/body.sh"
    os::ssh_build_script "$RUN_DIR/body.sh" "$RUN_DIR/remote.sh"
    SCRIPT_PREPARED=true
    for spec in "${OPT_UPLOAD[@]+"${OPT_UPLOAD[@]}"}"; do
        [[ $spec == *:* && -n ${spec%%:*} && -n ${spec#*:} ]] || os::die "$EX_USAGE" "--upload '$spec' must be LOCAL:REMOTE"
        [[ -e ${spec%%:*} ]] || os::die "$EX_USAGE" "--upload source '${spec%%:*}' does not exist"
    done
    for spec in "${OPT_DOWNLOAD[@]+"${OPT_DOWNLOAD[@]}"}"; do
        [[ $spec == *:* && -n ${spec%%:*} && -n ${spec#*:} ]] || os::die "$EX_USAGE" "--download '$spec' must be REMOTE:LOCAL"
    done
    OPT_WAIT=true
    OPT_WAIT_SSH=true

    RUN_PHASE=create
    os::group "create instance $OPT_NAME"
    CLEANUP_INSTANCE=$OPT_NAME
    os::create_flow "$OPT_NAME"
    os::endgroup

    if (( ${#OPT_UPLOAD[@]} )); then
        RUN_PHASE=upload
        os::group "upload"
        for spec in "${OPT_UPLOAD[@]}"; do
            os::transfer "$OPT_NAME" upload "$spec" || os::die "$EX_SSH" "upload of '${spec%%:*}' failed"
        done
        os::endgroup
    fi

    RUN_PHASE="exec"
    os::group "exec on $OPT_NAME"
    rc=0
    os::exec_flow "$OPT_NAME" || rc=$?
    os::endgroup
    if [[ $EXEC_TIMED_OUT == true ]]; then
        rc=124
    fi
    case $rc in
        0) RUN_EXIT=0 ;;
        124)
            if [[ $EXEC_TIMED_OUT == true ]]; then
                RUN_EXIT=$EX_TIMEOUT
            elif [[ $OPT_PASSTHROUGH == true ]]; then
                REMOTE_PASSTHROUGH=true
                RUN_EXIT=$rc
            else
                RUN_EXIT=$EX_REMOTE
            fi
            os::out phase_failed exec
            ;;
        255) RUN_EXIT=$EX_SSH; os::out phase_failed exec ;;
        *)
            if [[ $OPT_PASSTHROUGH == true ]]; then
                REMOTE_PASSTHROUGH=true
                RUN_EXIT=$rc
            else
                RUN_EXIT=$EX_REMOTE
            fi
            os::out phase_failed exec
            ;;
    esac

    if (( ${#OPT_DOWNLOAD[@]} )); then
        RUN_PHASE=download
        os::group "download"
        for spec in "${OPT_DOWNLOAD[@]}"; do
            rc=0
            os::transfer "$OPT_NAME" download "$spec" || rc=$?
            if (( rc != 0 )); then
                if [[ $OPT_STRICT_DOWNLOAD == true ]]; then
                    os::error "download of '${spec%%:*}' failed (--strict-download)"
                    if (( RUN_EXIT == 0 )); then
                        RUN_EXIT=$EX_SSH
                        os::out phase_failed download
                    fi
                else
                    os::warn "download of '${spec%%:*}' failed (scp exit $rc); continuing"
                fi
            fi
        done
        os::endgroup
    fi

    RUN_PHASE=delete
    EXIT_CODE=$RUN_EXIT
    os::cleanup_run || true
    if (( EXIT_CODE != 0 )) && [[ -z $(os::out_get phase_failed) ]]; then
        os::out phase_failed delete
    fi
    RUN_PHASE=""
    rc=${EXIT_CODE:-0}
    os::instance_table
    os::kv "created" "$CREATE_CREATED"
    os::kv "reused" "$CREATE_REUSED"
    os::kv "cloud-init" "$(os::out_get cloud_init_status)"
    os::kv "remote exit" "$(os::out_get remote_exit_code)"
    os::kv "duration" "$(os::out_get duration_seconds)s"
    os::kv "deleted" "$(os::out_get deleted)"
    if (( rc != 0 )); then
        if (( rc == RUN_EXIT )) && [[ $(os::out_get phase_failed) == exec ]]; then
            os::error "run failed: remote script exited with status ${REMOTE_EXIT:-$rc}"
        elif (( rc == EX_CLEANUP )); then
            os::error "run failed: the instance could not be deleted (see above)"
        else
            os::error "run failed in phase '$(os::out_get phase_failed)' with exit $rc"
        fi
        exit "$rc"
    fi
    return 0
}

