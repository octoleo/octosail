###############################################################################
# function lightsail_reboot_instance
#
# This function reboots a single Amazon Lightsail instance.
#
# Parameters:
#       -n instance_name - The NAME of the instance to reboot.
#       -h - Display help.
#
# Returns:
#       0 - If successful.
#       1 - If it fails.
###############################################################################
function lightsail_reboot_instance() {
    local instance_name
    local option OPTARG

    function usage() {
        echo "function lightsail_reboot_instance"
        echo "Reboots a single Amazon Lightsail instance."
        echo "  -n instance_name - The NAME of the instance to reboot."
        echo "  -h - Display help."
        echo ""
    }

    while getopts "n:h" option; do
        case "${option}" in
            n) instance_name="${OPTARG}" ;;
            h)
                usage
                return 0
                ;;
            \?)
                echo "Invalid parameter"
                usage
                return 1
                ;;
        esac
    done
    export OPTIND=1

    if [[ -z "$instance_name" ]]; then
        echo "ERROR: You must provide an instance name with the -n parameter."
        usage
        return 1
    fi

    # Stop the instance
    lightsail_stop_instance -n "${instance_name}" || {
        echo "ERROR: Failed to stop the instance."
        return 1
    }

    # Poll the status until it's 'stopped'
    local state=""
    echo "Waiting for the instance to stop..."
    while true; do
        state=$(aws lightsail get-instance-state --instance-name "${instance_name}" --query 'state.name' --output text) || {
            echo "ERROR: Failed to get instance state."
            return 1
        }
        if [[ "$state" == "stopped" ]]; then
            echo "Instance has stopped."
            break
        else
            echo "Current state: $state. Waiting..."
            sleep 5
        fi
    done

    # Wait for 1 minute
    echo "Waiting for 1 minute before starting the instance..."
    sleep 60

    # Start the instance
    lightsail_start_instance -n "${instance_name}" || {
        echo "ERROR: Failed to start the instance."
        return 1
    }

    echo "Instance rebooted successfully."

    return 0
}

###############################################################################
# Main script logic to handle --stop, --start, and --reboot directly for Lightsail.
###############################################################################
if [[ "$1" == "--stop" && -n "$2" ]]; then
    lightsail_stop_instance -n "$2"
    exit $?
elif [[ "$1" == "--start" && -n "$2" ]]; then
    lightsail_start_instance -n "$2"
    exit $?
elif [[ "$1" == "--reboot" && -n "$2" ]]; then
    lightsail_reboot_instance -n "$2"
    exit $?
else
    echo "Usage: $0 --stop <instance_name> | --start <instance_name> | --reboot <instance_name>"
    echo "       - Stops, starts, or reboots the specified Lightsail instance."
    exit 1
fi

