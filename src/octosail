###############################################################################
# Logging, GitHub Actions annotations, outputs
###############################################################################

declare -A LOG_LEVELS=([error]=0 [warn]=1 [info]=2 [debug]=3)

# os::log LEVEL MESSAGE... - write one log line to stderr (never to stdout).
os::log() {
    local level=$1
    shift
    local num=${LOG_LEVELS[$level]:-2}
    (( num > LOG_LEVEL_NUM )) && return 0
    local color="" reset=""
    if [[ $COLOR_ENABLED == true ]]; then
        reset=$'\033[0m'
        case $level in
            error) color=$'\033[1;31m' ;;
            warn) color=$'\033[1;33m' ;;
            info) color=$'\033[1;34m' ;;
            debug) color=$'\033[2m' ;;
        esac
    fi
    printf '%soctosail: [%s]%s %s\n' "$color" "$level" "$reset" "$*" >&2
}

os::debug() { os::log debug "$@"; }
os::info() { os::log info "$@"; }

# os::warn MESSAGE... - warning; becomes a ::warning:: annotation inside GitHub Actions.
os::warn() {
    if [[ $IN_ACTIONS == true ]]; then
        printf '::warning::%s\n' "$(os::annot_escape "$*")" >&2
    else
        os::log warn "$@"
    fi
}

# os::error MESSAGE... - error; becomes a ::error:: annotation inside GitHub Actions.
os::error() {
    if [[ $IN_ACTIONS == true ]]; then
        printf '::error::%s\n' "$(os::annot_escape "$*")" >&2
    else
        os::log error "$@"
    fi
}

# os::notice MESSAGE... - informational annotation in Actions, plain info elsewhere.
os::notice() {
    if [[ $IN_ACTIONS == true ]]; then
        printf '::notice::%s\n' "$(os::annot_escape "$*")" >&2
    else
        os::log info "$@"
    fi
}

# Escape a message for a workflow command (percent, newline, carriage return).
os::annot_escape() {
    local s=$1
    s=${s//%/%25}
    s=${s//$'\r'/%0D}
    s=${s//$'\n'/%0A}
    printf '%s' "$s"
}

# os::group TITLE / os::endgroup - collapsible log groups in Actions.
os::group() {
    if [[ $IN_ACTIONS == true ]]; then
        printf '::group::%s\n' "$*" >&2
    else
        os::info "--- $* ---"
    fi
}

os::endgroup() {
    if [[ $IN_ACTIONS == true ]]; then
        printf '::endgroup::\n' >&2
    fi
}

# os::mask VALUE - register every non-empty line of VALUE as a secret with the Actions runner.
os::mask() {
    [[ $IN_ACTIONS == true && -n ${1:-} ]] || return 0
    local line
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        [[ -n ${line//[[:space:]]/} ]] || continue
        printf '::add-mask::%s\n' "$line" >&2
    done <<<"$1"
}

# os::die CODE MESSAGE... - log the final error and exit with CODE (the EXIT trap does the rest).
os::die() {
    local code=$1
    shift
    EXIT_CODE=$code
    os::error "$*"
    exit "$code"
}

# os::exit_name CODE - symbolic name of an exit code.
os::exit_name() {
    if [[ -n $REMOTE_EXIT && $REMOTE_PASSTHROUGH == true && $1 == "$REMOTE_EXIT" && $1 != 0 ]]; then
        printf 'REMOTE'
        return 0
    fi
    case $1 in
        0) printf 'OK' ;;
        1) printf 'GENERAL' ;;
        2) printf 'USAGE' ;;
        80) printf 'DEPENDENCY' ;;
        81) printf 'AUTH' ;;
        82) printf 'NOT_FOUND' ;;
        83) printf 'TIMEOUT' ;;
        84) printf 'STATE' ;;
        85) printf 'AWS_API' ;;
        86) printf 'SSH' ;;
        87) printf 'REFUSED' ;;
        88) printf 'CLEANUP' ;;
        89) printf 'CONFLICT' ;;
        90) printf 'CLOUD_INIT' ;;
        91) printf 'REMOTE' ;;
        130) printf 'SIGINT' ;;
        143) printf 'SIGTERM' ;;
        *) printf 'EXIT_%s' "$1" ;;
    esac
}

# os::out KEY VALUE - record an output (written to GITHUB_OUTPUT / --json at exit).
os::out() {
    local key=$1 val=${2-}
    if [[ -z ${OUT[$key]+x} ]]; then
        OUT_ORDER+=("$key")
    fi
    OUT[$key]=$val
}

# os::out_declare KEY... - make sure every documented key exists (empty) without overwriting.
os::out_declare() {
    local key
    for key in "$@"; do
        [[ -n ${OUT[$key]+x} ]] || os::out "$key" ""
    done
}

# os::out_get KEY - print the current value of an output.
os::out_get() {
    printf '%s' "${OUT[$1]-}"
}

# os::out_flush - append every output to the GITHUB_OUTPUT file.
os::out_flush() {
    [[ -n $OUTPUT_FILE ]] || return 0
    (( ${#OUT_ORDER[@]} )) || return 0
    local key val delim
    {
        for key in "${OUT_ORDER[@]}"; do
            val=${OUT[$key]}
            if [[ $val == *$'\n'* ]]; then
                delim="ghadelimiter_$(os::random_hex 8)"
                printf '%s%s<<%s\n%s\n%s\n' "$OUTPUT_PREFIX" "$key" "$delim" "$val" "$delim"
            else
                printf '%s%s=%s\n' "$OUTPUT_PREFIX" "$key" "$val"
            fi
        done
    } >>"$OUTPUT_FILE" 2>/dev/null || os::warn "cannot write outputs to $OUTPUT_FILE"
}

# os::summary - append a markdown table of the outputs to the job step summary.
os::summary() {
    [[ $STEP_SUMMARY == true && -n ${GITHUB_STEP_SUMMARY:-} ]] || return 0
    (( ${#OUT_ORDER[@]} )) || return 0
    local key val
    {
        printf '### octosail %s\n\n| Key | Value |\n|---|---|\n' "${COMMAND:-}"
        for key in "${OUT_ORDER[@]}"; do
            [[ $key == stdout ]] && continue
            val=${OUT[$key]}
            val=${val//$'\n'/ }
            val=${val//|/\\|}
            if (( ${#val} > 200 )); then
                val="${val:0:200}..."
            fi
            printf '| %s | %s |\n' "\`${OUTPUT_PREFIX}${key}\`" "$val"
        done
        printf '\n'
    } >>"$GITHUB_STEP_SUMMARY" 2>/dev/null || os::warn "cannot write step summary"
}

# os::json_result CODE - print the single JSON document for --json mode.
os::json_result() {
    [[ $JSON_MODE == true ]] || return 0
    local code=$1 key
    local -a args=()
    for key in "${OUT_ORDER[@]+"${OUT_ORDER[@]}"}"; do
        args+=(--arg "$key" "${OUT[$key]}")
    done
    local octo='{}'
    if (( ${#args[@]} )); then
        octo=$(jq -cn "${args[@]}" '$ARGS.named') || octo='{}'
    fi
    local instance="null"
    if [[ -n $JSON_INSTANCE ]] && jq -e . >/dev/null 2>&1 <<<"$JSON_INSTANCE"; then
        instance=$JSON_INSTANCE
    fi
    jq -n --arg command "${COMMAND:-}" --argjson code "$code" --arg name "$(os::exit_name "$code")" \
        --argjson instance "$instance" --argjson octosail "$octo" \
        '{command: $command, ok: ($code == 0), exit_code: $code, exit_name: $name, instance: $instance, octosail: $octosail}' \
        2>/dev/null || printf '{"command":"%s","ok":false,"exit_code":%s,"exit_name":"%s","instance":null,"octosail":{}}\n' \
        "${COMMAND:-}" "$code" "$(os::exit_name "$code")"
}

###############################################################################
# Utilities
###############################################################################

os::random_hex() {
    local bytes=${1:-4}
    od -An -N"$bytes" -tx1 /dev/urandom | tr -d ' \n'
}

os::require_cmd() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || os::die "$EX_DEP" "required command '$cmd' is not installed (run 'octosail doctor' or the action's dependency installer)"
    done
}

# os::has_cmd NAME - true when NAME is on PATH.
os::has_cmd() {
    command -v "$1" >/dev/null 2>&1
}

# os::to_bool VALUE LABEL - normalise a boolean into BOOL (true/false); usage error otherwise.
os::to_bool() {
    local v=${1,,} label=${2:-value}
    case $v in
        1|true|yes|on|y) BOOL=true ;;
        0|false|no|off|n|"") BOOL=false ;;
        *) os::die "$EX_USAGE" "$label: '$1' is not a boolean (use true/false)" ;;
    esac
}

# os::to_seconds VALUE LABEL - parse a duration (Ns|Nm|Nh|Nd or bare seconds) into SECS.
os::to_seconds() {
    local v=$1 label=${2:-duration} n unit
    if [[ $v =~ ^([0-9]+)([smhd]?)$ ]]; then
        n=${BASH_REMATCH[1]}
        unit=${BASH_REMATCH[2]}
        case $unit in
            m) SECS=$((n * 60)) ;;
            h) SECS=$((n * 3600)) ;;
            d) SECS=$((n * 86400)) ;;
            *) SECS=$n ;;
        esac
        return 0
    fi
    os::die "$EX_USAGE" "$label: '$v' is not a duration (use e.g. 30, 90s, 15m, 6h, 2d)"
}

# os::env_normalise - validate every boolean / duration OCTOSAIL_* variable once, in place.
os::env_normalise() {
    local var
    for var in OCTOSAIL_JSON OCTOSAIL_NO_COLOR OCTOSAIL_DRY_RUN OCTOSAIL_KEEP_TEMP OCTOSAIL_YES OCTOSAIL_STEP_SUMMARY \
        OCTOSAIL_STATIC_IP OCTOSAIL_WAIT OCTOSAIL_WAIT_SSH OCTOSAIL_CLOUD_INIT_STRICT OCTOSAIL_SUDO OCTOSAIL_STRICT \
        OCTOSAIL_CAPTURE OCTOSAIL_PASSTHROUGH OCTOSAIL_START_IF_STOPPED OCTOSAIL_COPY_RECURSIVE OCTOSAIL_KEEP_ON_FAILURE \
        OCTOSAIL_STRICT_DOWNLOAD OCTOSAIL_CLEANUP_WAIT OCTOSAIL_RELEASE_STATIC_IP OCTOSAIL_DELETE_KEY_PAIR \
        OCTOSAIL_FORCE_DELETE_ADD_ONS OCTOSAIL_FORCE_STOP OCTOSAIL_HARD OCTOSAIL_MANAGED OCTOSAIL_EXPIRED \
        OCTOSAIL_ALL_MANAGED OCTOSAIL_OFFLINE OCTOSAIL_NAMES; do
        [[ -n ${!var:-} ]] || continue
        os::to_bool "${!var}" "$var"
        export "$var=$BOOL"
    done
    for var in OCTOSAIL_TIMEOUT OCTOSAIL_TTL OCTOSAIL_CREATE_TIMEOUT OCTOSAIL_DELETE_TIMEOUT OCTOSAIL_STATE_TIMEOUT \
        OCTOSAIL_WAIT_TIMEOUT OCTOSAIL_EXEC_TIMEOUT OCTOSAIL_SNAPSHOT_TIMEOUT OCTOSAIL_OPERATION_TIMEOUT \
        OCTOSAIL_SSH_TIMEOUT OCTOSAIL_CLOUD_INIT_TIMEOUT OCTOSAIL_OLDER_THAN OCTOSAIL_POLL_INTERVAL \
        OCTOSAIL_POLL_INTERVAL_MAX; do
        [[ -n ${!var:-} ]] || continue
        os::to_seconds "${!var}" "$var"
        export "$var=$SECS"
    done
    if [[ -n ${OCTOSAIL_SLEEP_FACTOR:-} && ! ${OCTOSAIL_SLEEP_FACTOR} =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        os::die "$EX_USAGE" "OCTOSAIL_SLEEP_FACTOR: '${OCTOSAIL_SLEEP_FACTOR}' is not a number"
    fi
    for var in OCTOSAIL_AWS_RETRIES OCTOSAIL_AWS_RETRY_BASE OCTOSAIL_AWS_RETRY_CAP OCTOSAIL_OUTPUT_MAX_BYTES OCTOSAIL_SSH_PORT; do
        if [[ -n ${!var:-} && ! ${!var} =~ ^[0-9]+$ ]]; then
            os::die "$EX_USAGE" "$var: '${!var}' is not a positive integer"
        fi
    done
}

# os::split_commas VALUE ARRAY_NAME - split a comma separated list into an array (trimmed, empties dropped).
os::split_commas() {
    local value=$1 dest=$2 item
    local -a items=()
    IFS=',' read -r -a items <<<"$value"
    eval "$dest=()"
    for item in "${items[@]+"${items[@]}"}"; do
        item=${item#"${item%%[![:space:]]*}"}
        item=${item%"${item##*[![:space:]]}"}
        [[ -n $item ]] || continue
        eval "$dest+=(\"\$item\")"
    done
}

# os::split_lines VALUE ARRAY_NAME - split a newline separated list (blank and # lines dropped).
os::split_lines() {
    local value=$1 dest=$2 line
    eval "$dest=()"
    [[ -n $value ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        [[ -n ${line//[[:space:]]/} ]] || continue
        [[ ${line#"${line%%[![:space:]]*}"} == \#* ]] && continue
        eval "$dest+=(\"\$line\")"
    done <<<"$value"
}

# os::shell_quote VALUE - single-quote VALUE for a POSIX shell.
os::shell_quote() {
    local s=$1 q="'\\''"
    printf "'%s'" "${s//\'/$q}"
}

# os::sleep SECONDS - sleep scaled by OCTOSAIL_SLEEP_FACTOR (0 in tests). The sleep runs in the
# background and is waited for, so SIGINT/SIGTERM are handled immediately instead of after the sleep.
os::sleep() {
    local secs=$1 scaled
    scaled=$(awk -v s="$secs" -v f="$SLEEP_FACTOR" 'BEGIN { printf "%.2f", s * f }')
    [[ $scaled == 0.00 ]] && return 0
    sleep "$scaled" &
    CHILD_PID=$!
    wait "$CHILD_PID" || true
    CHILD_PID=""
}

# os::backoff CURRENT [MAX] - next poll interval (x1.5, capped).
os::backoff() {
    local cur=$1 max=${2:-$POLL_INTERVAL_MAX} next
    next=$(( (cur * 3 + 1) / 2 ))
    (( next > max )) && next=$max
    (( next < 1 )) && next=1
    printf '%s' "$next"
}

# os::retry_delay ATTEMPT - exponential backoff with jitter for AWS retries.
os::retry_delay() {
    local attempt=$1 delay
    delay=$(( AWS_RETRY_BASE * (1 << (attempt - 1)) ))
    (( delay > AWS_RETRY_CAP )) && delay=$AWS_RETRY_CAP
    printf '%s' "$(( delay + RANDOM % 2 ))"
}

# os::max_attempts BUDGET - attempt cap so that timeouts are deterministic with a zero sleep factor.
os::max_attempts() {
    local budget=$1 n
    n=$(( (budget + POLL_INTERVAL - 1) / POLL_INTERVAL ))
    (( n < 1 )) && n=1
    printf '%s' "$n"
}

# os::global_deadline_check - enforce --timeout at every polling point.
os::global_deadline_check() {
    (( GLOBAL_DEADLINE > 0 )) || return 0
    if (( SECONDS >= GLOBAL_DEADLINE )); then
        os::die "$EX_TIMEOUT" "global timeout of ${GLOBAL_TIMEOUT}s exceeded"
    fi
}

# Date helpers (GNU and BSD date).
os::date_flavor() {
    if [[ -z $DATE_FLAVOR ]]; then
        if [[ $(date -u -r 0 +%Y 2>/dev/null) == 1970 ]]; then
            DATE_FLAVOR=bsd
        else
            DATE_FLAVOR=gnu
        fi
    fi
    printf '%s' "$DATE_FLAVOR"
}

os::now_epoch() {
    date -u +%s
}

os::now_iso() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

# os::epoch_to_iso EPOCH
os::epoch_to_iso() {
    if [[ $(os::date_flavor) == bsd ]]; then
        date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ
    else
        date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ
    fi
}

# os::iso_to_epoch ISO - prints epoch seconds (0 when unparseable). Fractions and offsets are dropped (Lightsail is UTC).
os::iso_to_epoch() {
    local iso=$1 base out
    if [[ ! $iso =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2} ]]; then
        printf '0'
        return 0
    fi
    base=${iso:0:19}
    if [[ $(os::date_flavor) == bsd ]]; then
        out=$(date -u -j -f %Y-%m-%dT%H:%M:%S "$base" +%s 2>/dev/null) || out=0
    else
        out=$(date -u -d "${base}Z" +%s 2>/dev/null) || out=0
    fi
    printf '%s' "${out:-0}"
}

# os::mkrundir - private working directory for keys, scripts and captures.
os::mkrundir() {
    [[ -n $RUN_DIR ]] && return 0
    local parent=$TMP_PARENT
    mkdir -p "$parent" 2>/dev/null || os::die "$EX_DEP" "cannot create temp parent directory $parent"
    RUN_DIR=$(mktemp -d "$parent/octosail.XXXXXX") || os::die "$EX_DEP" "cannot create a run directory under $parent"
    chmod 700 "$RUN_DIR"
    export OCTOSAIL_RUN_DIR=$RUN_DIR
    os::debug "run dir: $RUN_DIR"
}

# os::rundir_cleanup - remove key material always; remove the whole directory unless --keep-temp.
os::rundir_cleanup() {
    [[ -n $RUN_DIR && -d $RUN_DIR ]] || return 0
    local f
    for f in "$RUN_DIR/id_key" "$RUN_DIR/id_key-cert.pub" "$RUN_DIR/id_key.pub"; do
        [[ -e $f ]] || continue
        if os::has_cmd shred; then
            shred -u "$f" 2>/dev/null || rm -f "$f"
        else
            rm -f "$f"
        fi
    done
    if [[ $KEEP_TEMP == true ]]; then
        os::info "keeping run directory $RUN_DIR"
    else
        rm -rf "$RUN_DIR"
    fi
}

# os::validate_name NAME LABEL - Lightsail resource name rules.
os::validate_name() {
    local name=$1 label=${2:-instance name}
    [[ -n $name ]] || os::die "$EX_USAGE" "$label is required (use --name, a positional argument or OCTOSAIL_NAME)"
    [[ $name =~ $NAME_RE ]] || os::die "$EX_USAGE" "$label '$name' is invalid: 1-255 characters, letters, digits, '.', '-' and '_', starting and ending with a letter or digit"
}

# os::validate_env_name NAME
os::validate_env_name() {
    [[ $1 =~ $ENV_NAME_RE ]] || os::die "$EX_USAGE" "'$1' is not a valid environment variable name"
}

# os::in_actions - true inside GitHub Actions.
os::in_actions() {
    [[ ${GITHUB_ACTIONS:-} == true ]]
}

# os::default_name - the instance name used when none was given.
os::default_name() {
    if [[ $IN_ACTIONS == true && -n ${GITHUB_RUN_ID:-} ]]; then
        printf 'octosail-%s-%s' "$GITHUB_RUN_ID" "${GITHUB_RUN_ATTEMPT:-1}"
        return 0
    fi
    case $COMMAND in
        create|run) printf 'octosail-%s-%s' "$(os::now_epoch)" "$(os::random_hex 2)" ;;
        *) printf '' ;;
    esac
}

# os::file_world_readable FILE - true when group or others can read FILE (portable, via ls).
os::file_world_readable() {
    local perm
    # shellcheck disable=SC2012 # ls -l is the portable way to read the mode string (GNU/BSD stat differ)
    perm=$(ls -ld -- "$1" 2>/dev/null | cut -c1-10) || return 1
    [[ ${perm:4:1} == r || ${perm:7:1} == r ]]
}

# os::config_load FILE - KEY=VALUE config file, never sourced; only fills unset/empty variables.
os::config_load() {
    local file=$1 line key val n=0
    [[ -n $file && $file != /dev/null && -f $file ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        line=${line%$'\r'}
        line=${line#"${line%%[![:space:]]*}"}
        [[ -z $line || $line == \#* ]] && continue
        if [[ $line =~ ^(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
            key=${BASH_REMATCH[2]}
            val=${BASH_REMATCH[3]}
            val=${val%"${val##*[![:space:]]}"}
            if (( ${#val} >= 2 )); then
                case $val in
                    \"*\") val=${val:1:${#val}-2} ;;
                    \'*\') val=${val:1:${#val}-2} ;;
                esac
            fi
            [[ $key =~ ^(OCTOSAIL|AWS)_[A-Z0-9_]+$ ]] || os::die "$EX_USAGE" "$file:$n: unsupported key '$key' (only OCTOSAIL_* and AWS_* keys are accepted)"
            if [[ -z ${!key:-} ]]; then
                export "$key=$val"
                CONFIG_KEYS+=("$key")
            fi
        else
            os::die "$EX_USAGE" "$file:$n: cannot parse line (expected KEY=VALUE)"
        fi
    done <"$file"
    CONFIG_FILE=$file
    if grep -qE '^[[:space:]]*(export[[:space:]]+)?(AWS_SECRET_ACCESS_KEY|AWS_SESSION_TOKEN|OCTOSAIL_SSH_PRIVATE_KEY)[[:space:]]*=' "$file" 2>/dev/null \
        && os::file_world_readable "$file"; then
        os::warn "config file $file contains secrets and is readable by other users (chmod 600 $file)"
    fi
}

# os::config_find - the first existing config file from the search list. Inside GitHub Actions the
# checked-out workspace is untrusted, so ./.octosail.conf is only honoured through --config/OCTOSAIL_CONFIG.
os::config_find() {
    local candidate home=${HOME:-}
    local -a candidates=()
    [[ $IN_ACTIONS == true ]] || candidates+=("./.octosail.conf")
    if [[ -n ${XDG_CONFIG_HOME:-} ]]; then
        candidates+=("$XDG_CONFIG_HOME/octosail/config")
    elif [[ -n $home ]]; then
        candidates+=("$home/.config/octosail/config")
    fi
    [[ -n $home ]] && candidates+=("$home/.octosail.conf")
    for candidate in "${candidates[@]+"${candidates[@]}"}"; do
        if [[ -f $candidate ]]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    printf ''
}

# os::redact_argv ARGV... - argv for debug logs with secret-bearing values replaced.
os::redact_argv() {
    local -a out=()
    local redact_next=false a
    for a in "$@"; do
        if [[ $redact_next == true ]]; then
            out+=("<redacted>")
            redact_next=false
            continue
        fi
        case $a in
            --user-data|--public-key-base64|--private-key-base64) out+=("$a"); redact_next=true ;;
            --user-data=*|--public-key-base64=*) out+=("${a%%=*}=<redacted>") ;;
            *) out+=("$a") ;;
        esac
    done
    printf '%q ' "${out[@]}"
}

TIMED_OUT=false
TIMEOUT_REASON=""

# os::pretty_argv ARGV... - argv for log lines: plain words as they are, anything else single-quoted;
# secret-bearing values are redacted like os::redact_argv.
os::pretty_argv() {
    local -a out=()
    local redact_next=false a
    for a in "$@"; do
        if [[ $redact_next == true ]]; then
            out+=("<redacted>")
            redact_next=false
            continue
        fi
        case $a in
            --user-data|--public-key-base64|--private-key-base64) out+=("$a"); redact_next=true ;;
            --user-data=*|--public-key-base64=*) out+=("${a%%=*}=<redacted>") ;;
            *)
                if [[ $a =~ ^[A-Za-z0-9_./:=@+,-]+$ ]]; then
                    out+=("$a")
                else
                    out+=("$(os::shell_quote "$a")")
                fi
                ;;
        esac
    done
    printf '%s' "${out[*]}"
}

# os::with_timeout LIMIT STDIN_FILE STDOUT_FILE STDERR_FILE COMMAND... - run COMMAND with a bash watchdog.
# STDOUT_FILE/STDERR_FILE may be "-" to inherit. Returns the command's status; when the watchdog killed the
# command after LIMIT seconds (LIMIT 0 = unlimited) TIMED_OUT is true, TIMEOUT_REASON is "limit" or "global"
# and the status is 124. The global --timeout always caps LIMIT. The child PID is in CHILD_PID for the
# signal handler.
os::with_timeout() {
    local limit=$1 stdin=$2 stdout=$3 stderr=$4
    shift 4
    local rc=0 marker watchdog="" remaining
    TIMED_OUT=false
    TIMEOUT_REASON="limit"
    if (( GLOBAL_DEADLINE > 0 )); then
        remaining=$((GLOBAL_DEADLINE - SECONDS))
        (( remaining > 0 )) || os::die "$EX_TIMEOUT" "global timeout of ${GLOBAL_TIMEOUT}s exceeded"
        if (( limit == 0 || limit > remaining )); then
            limit=$remaining
            TIMEOUT_REASON="global"
        fi
    fi
    marker="$RUN_DIR/timeout.$$.$RANDOM.$RANDOM"
    if [[ $stdout == - && $stderr == - ]]; then
        "$@" <"$stdin" &
    elif [[ $stdout == - ]]; then
        "$@" <"$stdin" 2>"$stderr" &
    elif [[ $stderr == - ]]; then
        "$@" <"$stdin" >"$stdout" &
    else
        "$@" <"$stdin" >"$stdout" 2>"$stderr" &
    fi
    CHILD_PID=$!
    if (( limit > 0 )); then
        (
            waited=0
            while (( waited < limit )); do
                sleep 1
                waited=$((waited + 1))
                kill -0 "$CHILD_PID" 2>/dev/null || exit 0
            done
            : >"$marker"
            kill -TERM "$CHILD_PID" 2>/dev/null || exit 0
            sleep 2
            kill -KILL "$CHILD_PID" 2>/dev/null || true
        ) &
        watchdog=$!
    fi
    wait "$CHILD_PID" || rc=$?
    CHILD_PID=""
    if [[ -n $watchdog ]]; then
        kill "$watchdog" 2>/dev/null || true
        wait "$watchdog" 2>/dev/null || true
    fi
    if [[ -f $marker ]]; then
        rm -f "$marker"
        TIMED_OUT=true
        return 124
    fi
    return "$rc"
}

# os::json_tags "k=v"... - Lightsail tag list as JSON.
os::json_tags() {
    if (( $# == 0 )); then
        printf '[]'
        return 0
    fi
    jq -cn --args '$ARGS.positional | map(capture("^(?<key>[^=]+)=(?<value>.*)$") // {key: ., value: ""})' "$@"
}

PORT_JSON=""

# os::parse_port_spec SPEC - "[PORT[-PORT]/]PROTO[@CIDR[,CIDR...]]" to a Lightsail PortInfo JSON object in PORT_JSON.
os::parse_port_spec() {
    local spec=$1 left ports="" proto cidrs="" from to
    left=${spec%%@*}
    [[ $spec == *@* ]] && cidrs=${spec#*@}
    if [[ $left == */* ]]; then
        ports=${left%/*}
        proto=${left##*/}
    else
        proto=$left
    fi
    proto=${proto,,}
    case $proto in
        tcp|udp)
            [[ -n $ports ]] || os::die "$EX_USAGE" "port spec '$spec': a port or port range is required for $proto"
            if [[ $ports =~ ^([0-9]{1,5})(-([0-9]{1,5}))?$ ]]; then
                from=${BASH_REMATCH[1]}
                to=${BASH_REMATCH[3]:-$from}
            else
                os::die "$EX_USAGE" "port spec '$spec': '$ports' is not a port or PORT-PORT range"
            fi
            (( from <= 65535 && to <= 65535 && from <= to )) || os::die "$EX_USAGE" "port spec '$spec': ports must be 0-65535 and FROM <= TO"
            ;;
        icmp|icmpv6)
            [[ -z $ports ]] || os::die "$EX_USAGE" "port spec '$spec': $proto does not take a port"
            from=-1
            to=-1
            ;;
        all)
            [[ -z $ports ]] || os::die "$EX_USAGE" "port spec '$spec': 'all' does not take a port"
            from=0
            to=65535
            ;;
        *) os::die "$EX_USAGE" "port spec '$spec': unknown protocol '$proto' (tcp, udp, icmp, icmpv6, all)" ;;
    esac
    local -a all=() v4=() v6=()
    local c
    if [[ -n $cidrs ]]; then
        os::split_commas "$cidrs" all
        for c in "${all[@]+"${all[@]}"}"; do
            if [[ $c == *:* ]]; then
                v6+=("$c")
            else
                v4+=("$c")
            fi
        done
    else
        case $proto in
            icmp) v4=("0.0.0.0/0") ;;
            icmpv6) v6=("::/0") ;;
            *) v4=("0.0.0.0/0"); v6=("::/0") ;;
        esac
    fi
    PORT_JSON=$(jq -cn --argjson from "$from" --argjson to "$to" --arg proto "$proto" \
        --argjson v4 "$(printf '%s\n' "${v4[@]+"${v4[@]}"}" | jq -R . | jq -cs 'map(select(length > 0))')" \
        --argjson v6 "$(printf '%s\n' "${v6[@]+"${v6[@]}"}" | jq -R . | jq -cs 'map(select(length > 0))')" \
        '{fromPort: $from, toPort: $to, protocol: $proto} + (if ($v4 | length) > 0 then {cidrs: $v4} else {} end) + (if ($v6 | length) > 0 then {ipv6Cidrs: $v6} else {} end)')
}

# os::port_summary INSTANCE_JSON - "from-to/proto" comma list from instance.networking.ports.
os::port_summary() {
    jq -r '[(.networking.ports // [])[] | (if .fromPort == .toPort then (.fromPort|tostring) else ((.fromPort|tostring) + "-" + (.toPort|tostring)) end) + "/" + (.protocol|ascii_downcase)] | join(",")' <<<"$1"
}

###############################################################################
# AWS layer
###############################################################################

# os::aws_is_mutating OP - operations skipped under --dry-run.
os::aws_is_mutating() {
    case $1 in
        create-*|delete-*|start-*|stop-*|reboot-*|open-*|close-*|put-*|allocate-*|attach-*|detach-*|release-*|import-*|tag-*|untag-*) return 0 ;;
        *) return 1 ;;
    esac
}

# os::aws_classify RC STDERR - notfound | auth | throttle | transient | invalid | missing | other
os::aws_classify() {
    local rc=$1 err=$2
    if (( rc == 127 || rc == 126 )); then
        printf 'missing'
        return 0
    fi
    local re_auth='AccessDenied|Unauthorized|Unauthenticated|ExpiredToken|InvalidClientTokenId|UnrecognizedClient|InvalidSignature|Unable to locate credentials|Partial credentials|security token|not authorized|InvalidAccessKeyId|SignatureDoesNotMatch|AuthFailure|SSO|sso session|Token for |token has expired|refresh failed|config profile .* could not be found|ProfileNotFound|credentials? (are|is|were) (invalid|expired)'
    local re_notfound='NotFoundException|does not exist|not found'
    local re_throttle='Throttl|TooManyRequests|RequestLimitExceeded|Rate exceeded'
    local re_transient='ServiceUnavailable|ServiceException|InternalError|InternalFailure|RequestTimeout|Could not connect|Connection reset|Read timeout|EndpointConnectionError|timed out|Temporary failure|\(50[234]\)|HTTP 50[234]|Bad Gateway|Gateway Time-?out'
    local re_invalid='InvalidInputException|OperationFailureException|ServiceLimitExceeded|AccountSetupInProgress|ValidationError|ValidationException'
    local restore
    restore=$(shopt -p nocasematch)
    shopt -s nocasematch
    local class=other
    if [[ $err =~ $re_auth ]]; then
        class=auth
    elif [[ $err =~ $re_notfound ]]; then
        class=notfound
    elif [[ $err =~ $re_throttle ]]; then
        class=throttle
    elif [[ $err =~ $re_transient ]]; then
        class=transient
    elif [[ $err =~ $re_invalid ]]; then
        class=invalid
    fi
    eval "$restore"
    printf '%s' "$class"
}

# os::aws_create_name ARGS... - the first instance name in a create-instances call (for the transient re-check).
os::aws_create_name() {
    local prev="" a
    for a in "$@"; do
        if [[ $prev == --instance-names ]]; then
            jq -r 'if type == "array" then .[0] // empty else . end' <<<"$a" 2>/dev/null || printf '%s' "$a"
            return 0
        fi
        prev=$a
    done
    printf ''
}

# os::aws SERVICE OP ARGS... - run one AWS CLI call with retries and classification.
# Sets AWS_OUT (stdout JSON), AWS_ERR (last stderr), AWS_CLASS. Returns 0, EX_NOTFOUND or EX_AWS;
# authentication failures and a missing CLI terminate the program (EX_AUTH / EX_DEP).
os::aws() {
    local service=$1 op=$2
    shift 2
    local -a cmd=("$AWS_BIN" --output json --no-cli-pager --cli-connect-timeout 10 --cli-read-timeout 60 --region "$REGION")
    if [[ -n $PROFILE ]]; then
        cmd+=(--profile "$PROFILE")
    fi
    if (( ${#AWS_EXTRA_ARGS[@]} )); then
        cmd+=("${AWS_EXTRA_ARGS[@]}")
    fi
    cmd+=("$service" "$op" "$@")
    AWS_OUT=""
    AWS_ERR=""
    AWS_CLASS=""
    if [[ $DRY_RUN == true ]] && os::aws_is_mutating "$op"; then
        os::info "DRY-RUN: $(os::redact_argv "${cmd[@]}")"
        AWS_OUT='{"operations":[],"dryRun":true}'
        return 0
    fi
    local attempt=0 rc delay errfile="$RUN_DIR/aws.err" outfile="$RUN_DIR/aws.out" name
    local re_exists='already (in use|exists)'
    while :; do
        rc=0
        os::debug "aws: $(os::redact_argv "${cmd[@]}")"
        AWS_PAGER="" AWS_CLI_AUTO_PROMPT=off AWS_MAX_ATTEMPTS=1 AWS_RETRY_MODE=standard "${cmd[@]}" >"$outfile" 2>"$errfile" </dev/null &
        CHILD_PID=$!
        wait "$CHILD_PID" || rc=$?
        CHILD_PID=""
        AWS_OUT=$(<"$outfile")
        if (( rc == 0 )); then
            return 0
        fi
        AWS_ERR=$(tr -d '\r' <"$errfile" 2>/dev/null | sed -e 's/^[[:space:]]*//' | grep -v '^$' | tail -n 5 | tr '\n' ' ' | sed -e 's/[[:space:]]*$//')
        [[ -n $AWS_ERR ]] || AWS_ERR="aws exited with status $rc"
        AWS_CLASS=$(os::aws_classify "$rc" "$AWS_ERR")
        case $AWS_CLASS in
            notfound) return "$EX_NOTFOUND" ;;
            auth) os::die "$EX_AUTH" "AWS authentication or authorization failed ($service $op): $AWS_ERR" ;;
            missing) os::die "$EX_DEP" "cannot execute the AWS CLI '$AWS_BIN': $AWS_ERR" ;;
            invalid)
                if [[ $op == create-instances* && $AWS_ERR =~ $re_exists ]]; then
                    name=$(os::aws_create_name "$@")
                    if [[ -n $name ]] && os::aws_exists_quiet "$name"; then
                        os::warn "instance '$name' already exists (a previous create request went through); continuing with it"
                        AWS_OUT='{"operations":[]}'
                        return 0
                    fi
                fi
                return "$EX_AWS"
                ;;
            throttle|transient)
                if [[ $AWS_CLASS == transient && $op == create-instances* ]]; then
                    name=$(os::aws_create_name "$@")
                    if [[ -n $name ]] && os::aws_exists_quiet "$name"; then
                        os::warn "create call failed transiently but instance '$name' exists; continuing with it"
                        AWS_OUT='{"operations":[]}'
                        return 0
                    fi
                fi
                attempt=$((attempt + 1))
                if (( attempt > AWS_RETRIES )); then
                    return "$EX_AWS"
                fi
                delay=$(os::retry_delay "$attempt")
                os::warn "aws $service $op failed ($AWS_CLASS); retry $attempt/$AWS_RETRIES in ${delay}s: $AWS_ERR"
                os::sleep "$delay"
                ;;
            *) return "$EX_AWS" ;;
        esac
    done
}

# os::aws_exists_quiet NAME - true when get-instance succeeds (no retries; AWS_OUT/AWS_ERR/AWS_CLASS are preserved).
os::aws_exists_quiet() {
    local saved_retries=$AWS_RETRIES saved_out=$AWS_OUT saved_err=$AWS_ERR saved_class=$AWS_CLASS rc=0
    AWS_RETRIES=2
    os::aws lightsail get-instance --instance-name "$1" || rc=$?
    AWS_RETRIES=$saved_retries
    AWS_OUT=$saved_out
    AWS_ERR=$saved_err
    AWS_CLASS=$saved_class
    (( rc == 0 ))
}

# os::aws_must SERVICE OP ARGS... - like os::aws but any failure terminates with the right exit code.
os::aws_must() {
    local rc=0
    os::aws "$@" || rc=$?
    case $rc in
        0) return 0 ;;
        "$EX_NOTFOUND") os::die "$EX_NOTFOUND" "$1 $2: resource not found: $AWS_ERR" ;;
        *) os::die "$EX_AWS" "$1 $2 failed: $AWS_ERR" ;;
    esac
}

# os::aws_paginate SERVICE OP JQ_KEY ARGS... - follow nextPageToken; AWS_OUT becomes the merged JSON array.
os::aws_paginate() {
    local service=$1 op=$2 key=$3
    shift 3
    local token="" merged='[]' page rc=0
    while :; do
        if [[ -n $token ]]; then
            os::aws "$service" "$op" "$@" --page-token "$token" || rc=$?
        else
            os::aws "$service" "$op" "$@" || rc=$?
        fi
        (( rc == 0 )) || return "$rc"
        page=$(jq -c --arg k "$key" '.[$k] // []' <<<"$AWS_OUT")
        merged=$(jq -cn --argjson a "$merged" --argjson b "$page" '$a + $b')
        token=$(jq -r '.nextPageToken // empty' <<<"$AWS_OUT")
        [[ -n $token ]] || break
    done
    AWS_OUT=$merged
    return 0
}

# os::op_wait RESPONSE_JSON [BUDGET] - wait for every operation in an AWS response to reach a terminal state.
os::op_wait() {
    local json=$1 budget=${2:-$OPERATION_TIMEOUT}
    local pending failed id status err deadline attempts max_attempts interval rc
    failed=$(jq -r '((.operations // []) + (if .operation then [.operation] else [] end))[] | select((.status // "") | ascii_downcase == "failed") | ((.errorCode // "unknown") + ": " + (.errorDetails // "no details"))' <<<"$json" 2>/dev/null | head -n1)
    if [[ -n $failed ]]; then
        os::die "$EX_AWS" "Lightsail operation failed: $failed"
    fi
    pending=$(jq -r '((.operations // []) + (if .operation then [.operation] else [] end))[] | select(.isTerminal != true and ((.status // "") | ascii_downcase | IN("succeeded", "completed") | not)) | .id // empty' <<<"$json" 2>/dev/null)
    [[ -n $pending ]] || return 0
    for id in $pending; do
        deadline=$((SECONDS + budget))
        attempts=0
        max_attempts=$(os::max_attempts "$budget")
        interval=$POLL_INTERVAL
        while :; do
            os::global_deadline_check
            rc=0
            os::aws lightsail get-operation --operation-id "$id" || rc=$?
            if (( rc == EX_NOTFOUND )); then
                os::debug "operation $id not found yet; retrying"
            elif (( rc != 0 )); then
                os::die "$EX_AWS" "get-operation $id failed: $AWS_ERR"
            else
                status=$(jq -r '.operation.status // "" | ascii_downcase' <<<"$AWS_OUT")
                case $status in
                    succeeded|completed) break ;;
                    failed)
                        err=$(jq -r '(.operation.errorCode // "unknown") + ": " + (.operation.errorDetails // "no details")' <<<"$AWS_OUT")
                        os::die "$EX_AWS" "Lightsail operation $id failed: $err"
                        ;;
                esac
                if [[ $(jq -r '.operation.isTerminal // false' <<<"$AWS_OUT") == true ]]; then
                    break
                fi
            fi
            attempts=$((attempts + 1))
            if (( SECONDS >= deadline || attempts >= max_attempts )); then
                os::die "$EX_TIMEOUT" "operation $id did not complete within ${budget}s (last status: ${status:-unknown})"
            fi
            os::sleep "$interval"
            interval=$(os::backoff "$interval")
        done
    done
    return 0
}

# os::instance_get NAME - read one instance into INST_* (returns EX_NOTFOUND when it does not exist).
os::instance_get() {
    local name=$1 rc=0 tsv
    os::aws lightsail get-instance --instance-name "$name" || rc=$?
    if (( rc == EX_NOTFOUND )); then
        INST_JSON=""
        return "$EX_NOTFOUND"
    fi
    (( rc == 0 )) || os::die "$EX_AWS" "get-instance $name failed: $AWS_ERR"
    INST_JSON=$(jq -c '.instance // {}' <<<"$AWS_OUT")
    tsv=$(jq -r '[.name, .state.name, .publicIpAddress, .privateIpAddress, .username, .blueprintId, .bundleId,
        .location.availabilityZone, .location.regionName, .sshKeyName, .arn, .isStaticIp, .createdAt,
        ((.ipv6Addresses // []) | join(","))]
        | map(if . == null then "" else tostring end) | join("\u001f")' <<<"$INST_JSON")
    IFS=$'\x1f' read -r INST_NAME INST_STATE INST_PUBLIC_IP INST_PRIVATE_IP INST_USERNAME INST_BLUEPRINT INST_BUNDLE \
        INST_AZ INST_REGION INST_KEY_NAME INST_ARN INST_IS_STATIC INST_CREATED_AT INST_IPV6 <<<"$tsv"
    return 0
}

# os::instance_tag KEY - value of a tag on the last read instance (empty when absent).
os::instance_tag() {
    [[ -n $INST_JSON ]] || return 0
    jq -r --arg k "$1" '[(.tags // [])[] | select(.key == $k) | .value] | first // empty' <<<"$INST_JSON"
}

# os::instance_is_managed / os::instance_is_protected - tag checks on the last read instance.
os::instance_is_managed() {
    [[ $(os::instance_tag "$TAG_MANAGED") == true ]]
}

os::instance_is_protected() {
    [[ $(os::instance_tag "$TAG_PROTECTED") == true ]]
}

# os::instance_tags_set NAME TAGS_JSON - tag-resource with a JSON list.
os::instance_tags_set() {
    local name=$1 tags=$2
    [[ $(jq -r 'length' <<<"$tags") -gt 0 ]] || return 0
    os::aws_must lightsail tag-resource --resource-name "$name" --tags "$tags"
    os::op_wait "$AWS_OUT"
}

# os::state_wait NAME TARGET BUDGET - poll get-instance-state until TARGET. Returns 0, EX_TIMEOUT or EX_STATE.
os::state_wait() {
    local name=$1 target=$2 budget=$3
    local deadline=$((SECONDS + budget)) attempts=0 max_attempts interval=$POLL_INTERVAL state="" last="" rc
    max_attempts=$(os::max_attempts "$budget")
    if [[ $DRY_RUN == true ]]; then
        os::info "DRY-RUN: would wait for '$name' to reach '$target'"
        INST_STATE=$target
        return 0
    fi
    while :; do
        os::global_deadline_check
        rc=0
        os::aws lightsail get-instance-state --instance-name "$name" || rc=$?
        if (( rc == EX_NOTFOUND )); then
            if [[ $target == absent ]]; then
                INST_STATE="absent"
                return 0
            fi
            os::die "$EX_STATE" "instance '$name' disappeared while waiting for state '$target'"
        fi
        (( rc == 0 )) || os::die "$EX_AWS" "get-instance-state $name failed: $AWS_ERR"
        state=$(jq -r '.state.name // empty' <<<"$AWS_OUT")
        INST_STATE=$state
        if [[ $state == "$target" ]]; then
            return 0
        fi
        case "$target:$state" in
            running:terminated|running:shutting-down|stopped:terminated|stopped:shutting-down)
                os::die "$EX_STATE" "instance '$name' is '$state'; it can never reach '$target'"
                ;;
        esac
        if [[ $state != "$last" ]]; then
            os::info "instance '$name' state: ${state:-unknown} (waiting for $target)"
            last=$state
        fi
        attempts=$((attempts + 1))
        if (( SECONDS >= deadline || attempts >= max_attempts )); then
            return "$EX_TIMEOUT"
        fi
        os::sleep "$interval"
        interval=$(os::backoff "$interval")
    done
}

# os::absent_wait NAME BUDGET - poll get-instance until it is gone.
os::absent_wait() {
    local name=$1 budget=$2
    local deadline=$((SECONDS + budget)) attempts=0 max_attempts interval=$POLL_INTERVAL rc
    max_attempts=$(os::max_attempts "$budget")
    if [[ $DRY_RUN == true ]]; then
        os::info "DRY-RUN: would wait for '$name' to be deleted"
        return 0
    fi
    while :; do
        os::global_deadline_check
        rc=0
        os::aws lightsail get-instance --instance-name "$name" || rc=$?
        if (( rc == EX_NOTFOUND )); then
            return 0
        fi
        (( rc == 0 )) || os::die "$EX_AWS" "get-instance $name failed: $AWS_ERR"
        attempts=$((attempts + 1))
        if (( SECONDS >= deadline || attempts >= max_attempts )); then
            return "$EX_TIMEOUT"
        fi
        os::sleep "$interval"
        interval=$(os::backoff "$interval")
    done
}

# os::key_fingerprint_md5 PUBFILE - lower-case colon-separated MD5 fingerprint of a public key file.
os::key_fingerprint_md5() {
    local out
    out=$(ssh-keygen -l -E md5 -f "$1" 2>/dev/null) || return 1
    out=${out#* }
    out=${out%% *}
    out=${out#MD5:}
    printf '%s' "${out,,}"
}

# os::key_fingerprint_der PUBFILE - lower-case colon-separated MD5 of the DER public key (EC2/Lightsail import style);
# empty when openssl is not available.
os::key_fingerprint_der() {
    local out
    os::has_cmd openssl || { printf ''; return 0; }
    out=$(ssh-keygen -e -m PKCS8 -f "$1" 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | openssl md5 -c 2>/dev/null) || { printf ''; return 0; }
    out=${out##* }
    printf '%s' "${out,,}"
}

# os::key_pair_ensure PUBFILE [NAME] - import a public key idempotently. Sets KEY_PAIR_NAME and KEY_PAIR_IMPORTED_NAME.
os::key_pair_ensure() {
    local pub=$1 name=${2:-} local_fp local_der remote_fp rc=0 b64
    [[ -f $pub ]] || os::die "$EX_USAGE" "public key file '$pub' not found"
    ssh-keygen -l -f "$pub" >/dev/null 2>&1 || os::die "$EX_USAGE" "'$pub' is not a valid OpenSSH public key"
    local_fp=$(os::key_fingerprint_md5 "$pub") || local_fp=""
    local_der=$(os::key_fingerprint_der "$pub")
    if [[ -z $name ]]; then
        name="octosail-$(awk '{print $1" "$2}' "$pub" | tr -d '\n' | { if os::has_cmd sha256sum; then sha256sum; else shasum -a 256; fi; } | cut -c1-12)"
    fi
    KEY_PAIR_NAME=$name
    os::aws lightsail get-key-pair --key-pair-name "$name" || rc=$?
    if (( rc == 0 )); then
        remote_fp=$(jq -r '.keyPair.fingerprint // empty' <<<"$AWS_OUT")
        remote_fp=${remote_fp#MD5:}
        remote_fp=${remote_fp,,}
        if [[ $remote_fp =~ ^([0-9a-f]{2}:){15}[0-9a-f]{2}$ && -n $local_fp ]]; then
            if [[ $remote_fp == "$local_fp" || ( -n $local_der && $remote_fp == "$local_der" ) ]]; then
                os::info "key pair '$name' already exists with the same fingerprint; reusing it"
            elif [[ -z $local_der ]]; then
                os::warn "key pair '$name' exists and its fingerprint ($remote_fp) does not match the OpenSSH fingerprint of '$pub' ($local_fp); openssl is not available to compare the DER fingerprint, so the key pair is reused by name"
            else
                os::die "$EX_CONFLICT" "key pair '$name' exists with a different fingerprint ($remote_fp; local $local_fp / $local_der); choose another --key-pair name"
            fi
        else
            os::warn "key pair '$name' exists but its fingerprint could not be compared; reusing it by name"
        fi
        return 0
    fi
    (( rc == EX_NOTFOUND )) || os::die "$EX_AWS" "get-key-pair $name failed: $AWS_ERR"
    b64=$(base64 <"$pub" | tr -d '\n')
    os::info "importing public key '$pub' as key pair '$name'"
    os::aws_must lightsail import-key-pair --key-pair-name "$name" --public-key-base64 "$b64"
    os::op_wait "$AWS_OUT"
    KEY_PAIR_IMPORTED_NAME=$name
    return 0
}

# os::static_ip_ensure INSTANCE IPNAME ALLOCATE - attach a static IP idempotently; allocate it first when ALLOCATE is true.
os::static_ip_ensure() {
    local instance=$1 ipname=$2 allocate=${3:-true} rc=0 attached_to is_attached
    os::aws lightsail get-static-ip --static-ip-name "$ipname" || rc=$?
    if (( rc == 0 )); then
        attached_to=$(jq -r '.staticIp.attachedTo // empty' <<<"$AWS_OUT")
        is_attached=$(jq -r '.staticIp.isAttached // false' <<<"$AWS_OUT")
        if [[ $is_attached == true && $attached_to == "$instance" ]]; then
            os::info "static IP '$ipname' is already attached to '$instance'"
            return 0
        fi
        if [[ $is_attached == true ]]; then
            os::die "$EX_CONFLICT" "static IP '$ipname' is attached to '$attached_to', not to '$instance'"
        fi
        os::info "reusing unattached static IP '$ipname'"
    else
        (( rc == EX_NOTFOUND )) || os::die "$EX_AWS" "get-static-ip $ipname failed: $AWS_ERR"
        [[ $allocate == true ]] || os::die "$EX_NOTFOUND" "static IP '$ipname' does not exist in $REGION (use --static-ip to allocate one)"
        os::info "allocating static IP '$ipname'"
        os::aws_must lightsail allocate-static-ip --static-ip-name "$ipname"
        os::op_wait "$AWS_OUT"
    fi
    os::info "attaching static IP '$ipname' to '$instance'"
    os::aws_must lightsail attach-static-ip --static-ip-name "$ipname" --instance-name "$instance"
    os::op_wait "$AWS_OUT"
    return 0
}

# os::static_ip_release IPNAME - detach (if attached) and release a static IP; tolerant of NotFound.
os::static_ip_release() {
    local ipname=$1 rc=0 is_attached
    os::aws lightsail get-static-ip --static-ip-name "$ipname" || rc=$?
    if (( rc == EX_NOTFOUND )); then
        os::info "static IP '$ipname' no longer exists"
        return 0
    fi
    (( rc == 0 )) || os::die "$EX_AWS" "get-static-ip $ipname failed: $AWS_ERR"
    is_attached=$(jq -r '.staticIp.isAttached // false' <<<"$AWS_OUT")
    if [[ $is_attached == true ]]; then
        os::info "detaching static IP '$ipname'"
        os::aws_must lightsail detach-static-ip --static-ip-name "$ipname"
        os::op_wait "$AWS_OUT"
    fi
    os::info "releasing static IP '$ipname'"
    os::aws_must lightsail release-static-ip --static-ip-name "$ipname"
    os::op_wait "$AWS_OUT"
    return 0
}

STATIC_IP_FOUND=""

# os::static_ip_find_attached INSTANCE - STATIC_IP_FOUND = name of the static IP attached to INSTANCE (paged lookup).
os::static_ip_find_attached() {
    local instance=$1
    STATIC_IP_FOUND=""
    os::aws_paginate lightsail get-static-ips staticIps || os::die "$EX_AWS" "get-static-ips failed: $AWS_ERR"
    STATIC_IP_FOUND=$(jq -r --arg i "$instance" '[.[] | select(.isAttached == true and .attachedTo == $i) | .name] | first // empty' <<<"$AWS_OUT")
}

# os::snapshot_create INSTANCE SNAPNAME BUDGET - create an instance snapshot and wait until it is available.
os::snapshot_create() {
    local instance=$1 snap=$2 budget=$3 rc=0 state deadline attempts max_attempts interval tags
    os::aws lightsail get-instance-snapshot --instance-snapshot-name "$snap" || rc=$?
    if (( rc == 0 )); then
        os::die "$EX_CONFLICT" "snapshot '$snap' already exists"
    fi
    (( rc == EX_NOTFOUND )) || os::die "$EX_AWS" "get-instance-snapshot $snap failed: $AWS_ERR"
    tags=$(os::json_tags "$TAG_MANAGED=true" "$TAG_FROM_INSTANCE=$instance" "$TAG_CREATED=$(os::now_iso)")
    os::info "creating snapshot '$snap' of '$instance'"
    os::aws_must lightsail create-instance-snapshot --instance-snapshot-name "$snap" --instance-name "$instance" --tags "$tags"
    os::op_wait "$AWS_OUT"
    if [[ $DRY_RUN == true ]]; then
        return 0
    fi
    deadline=$((SECONDS + budget))
    attempts=0
    max_attempts=$(os::max_attempts "$budget")
    interval=$POLL_INTERVAL
    while :; do
        os::global_deadline_check
        os::aws_must lightsail get-instance-snapshot --instance-snapshot-name "$snap"
        state=$(jq -r '.instanceSnapshot.state // empty' <<<"$AWS_OUT")
        case $state in
            available) os::info "snapshot '$snap' is available"; return 0 ;;
            error) os::die "$EX_AWS" "snapshot '$snap' ended in state 'error'" ;;
        esac
        attempts=$((attempts + 1))
        if (( SECONDS >= deadline || attempts >= max_attempts )); then
            os::die "$EX_TIMEOUT" "snapshot '$snap' not available within ${budget}s (state: ${state:-unknown})"
        fi
        os::sleep "$interval"
        interval=$(os::backoff "$interval")
    done
}

# os::ports_apply INSTANCE MODE SPEC... - open | close (one call per spec) or set (one put call).
os::ports_apply() {
    local instance=$1 mode=$2
    shift 2
    local spec json
    local -a infos=()
    for spec in "$@"; do
        os::parse_port_spec "$spec"
        infos+=("$PORT_JSON")
    done
    (( ${#infos[@]} )) || return 0
    case $mode in
        open)
            for json in "${infos[@]}"; do
                os::info "opening ports $(jq -r '(.fromPort|tostring) + "-" + (.toPort|tostring) + "/" + .protocol' <<<"$json") on '$instance'"
                os::aws_must lightsail open-instance-public-ports --instance-name "$instance" --port-info "$json"
                os::op_wait "$AWS_OUT"
            done
            ;;
        close)
            for json in "${infos[@]}"; do
                os::info "closing ports $(jq -r '(.fromPort|tostring) + "-" + (.toPort|tostring) + "/" + .protocol' <<<"$json") on '$instance'"
                os::aws_must lightsail close-instance-public-ports --instance-name "$instance" --port-info "$json"
                os::op_wait "$AWS_OUT"
            done
            ;;
        set)
            json=$(printf '%s\n' "${infos[@]}" | jq -cs '.')
            os::info "replacing the firewall of '$instance' with ${#infos[@]} rule(s)"
            os::aws_must lightsail put-instance-public-ports --instance-name "$instance" --port-infos "$json"
            os::op_wait "$AWS_OUT"
            ;;
    esac
    return 0
}

# os::region_resolve - --region > OCTOSAIL_REGION > AWS_REGION > AWS_DEFAULT_REGION > aws configure.
os::region_resolve() {
    [[ -n $REGION ]] || REGION=${OCTOSAIL_REGION:-${AWS_REGION:-${AWS_DEFAULT_REGION:-}}}
    if [[ -z $REGION ]] && os::has_cmd "$AWS_BIN"; then
        if [[ -n $PROFILE ]]; then
            REGION=$("$AWS_BIN" configure get region --profile "$PROFILE" 2>/dev/null </dev/null) || REGION=""
        else
            REGION=$("$AWS_BIN" configure get region 2>/dev/null </dev/null) || REGION=""
        fi
    fi
    [[ -n $REGION ]] || os::die "$EX_AUTH" "no AWS region configured (use --region, OCTOSAIL_REGION, AWS_REGION or 'aws configure')"
    [[ $REGION =~ ^[a-z]{2}(-[a-z]+)+-[0-9]+$ ]] || os::die "$EX_USAGE" "'$REGION' does not look like an AWS region (e.g. eu-west-1)"
}

###############################################################################
# SSH layer
###############################################################################

os::ssh_reset() {
    SSH_USER=""
    SSH_HOST=""
    SSH_PORT=${OPT_SSH_PORT:-22}
    SSH_KEY_FILE=""
    SSH_CERT_FILE=""
    SSH_KNOWN_HOSTS=""
    SSH_STRICT="yes"
    SSH_KEY_SOURCE_USED=""
    ACCESS_JSON=""
    ACCESS_EXPIRES=0
    SSH_READY=false
}

# os::write_secret_file DEST CONTENT [MODE] - write key material with a private umask.
os::write_secret_file() {
    local dest=$1 content=$2 mode=${3:-600}
    (
        umask 077
        printf '%s\n' "$content" >"$dest"
    ) || os::die "$EX_DEP" "cannot write $dest"
    chmod "$mode" "$dest"
}

# os::ssh_access_fetch NAME - get-instance-access-details into ACCESS_JSON (secrets masked immediately).
os::ssh_access_fetch() {
    local name=$1 rc=0 field exp
    os::aws lightsail get-instance-access-details --instance-name "$name" --protocol ssh || rc=$?
    if (( rc == EX_NOTFOUND )); then
        os::die "$EX_NOTFOUND" "instance '$name' not found while fetching access details"
    fi
    (( rc == 0 )) || os::die "$EX_AWS" "get-instance-access-details $name failed: $AWS_ERR"
    ACCESS_JSON=$(jq -c '.accessDetails // {}' <<<"$AWS_OUT")
    for field in privateKey certKey password passwordData; do
        os::mask "$(jq -r --arg f "$field" '.[$f] // empty' <<<"$ACCESS_JSON")"
    done
    exp=$(jq -r '.expiresAt // empty' <<<"$ACCESS_JSON")
    ACCESS_EXPIRES=$(os::iso_to_epoch "$exp")
    return 0
}

# os::ssh_write_lightsail_key - write privateKey / certKey from ACCESS_JSON into the run dir.
os::ssh_write_lightsail_key() {
    local pk cert
    pk=$(jq -r '.privateKey // empty' <<<"$ACCESS_JSON")
    [[ -n $pk ]] || return 1
    os::write_secret_file "$RUN_DIR/id_key" "$pk" 600
    SSH_KEY_FILE="$RUN_DIR/id_key"
    cert=$(jq -r '.certKey // empty' <<<"$ACCESS_JSON")
    if [[ -n $cert ]]; then
        os::write_secret_file "$RUN_DIR/id_key-cert.pub" "$cert" 644
        SSH_CERT_FILE="$RUN_DIR/id_key-cert.pub"
    else
        SSH_CERT_FILE=""
    fi
    return 0
}

# os::ssh_key_from_env DEST - normalise OCTOSAIL_SSH_PRIVATE_KEY (PEM, base64 or \n-escaped) into DEST.
os::ssh_key_from_env() {
    local dest=$1 raw=${OCTOSAIL_SSH_PRIVATE_KEY:-} decoded
    os::mask "$raw"
    if [[ $raw != *"-----BEGIN"* ]]; then
        if decoded=$(printf '%s' "$raw" | tr -d '\n\r\t ' | base64 --decode 2>/dev/null) && [[ $decoded == *"-----BEGIN"* ]]; then
            raw=$decoded
        else
            os::die "$EX_USAGE" "OCTOSAIL_SSH_PRIVATE_KEY is neither a PEM/OpenSSH private key nor base64 of one"
        fi
    fi
    if [[ $raw == *'\n'* && $raw != *$'\n'* ]]; then
        raw=$(printf '%b' "$raw")
    fi
    raw=${raw//$'\r'/}
    os::mask "$raw"
    os::write_secret_file "$dest" "$raw" 600
}

# os::ssh_default_key_download NAME DEST - fall back to the regional default key pair.
os::ssh_default_key_download() {
    local name=$1 dest=$2 b64 material
    if [[ $INST_KEY_NAME != "$DEFAULT_KEY_PAIR_PREFIX"* ]]; then
        os::die "$EX_SSH" "no usable private key: instance '$name' uses key pair '${INST_KEY_NAME:-unknown}'; provide --key-file or OCTOSAIL_SSH_PRIVATE_KEY"
    fi
    os::info "Lightsail did not return a temporary key; downloading the regional default key pair"
    os::aws_must lightsail download-default-key-pair
    b64=$(jq -r '.privateKeyBase64 // empty' <<<"$AWS_OUT")
    [[ -n $b64 ]] || os::die "$EX_SSH" "download-default-key-pair returned no private key"
    material=$(printf '%s' "$b64" | tr -d '\n\r ' | base64 --decode 2>/dev/null) || os::die "$EX_SSH" "default key pair could not be decoded"
    os::mask "$material"
    os::write_secret_file "$dest" "$material" 600
}

# os::ssh_validate_key FILE - the key must be a readable, unencrypted OpenSSH/PEM private key.
os::ssh_validate_key() {
    ssh-keygen -y -P '' -f "$1" >/dev/null 2>&1 </dev/null \
        || os::die "$EX_USAGE" "private key is not a valid, unencrypted OpenSSH/PEM key (source: ${SSH_KEY_SOURCE_USED:-unknown})"
}

# os::ssh_resolve_key NAME - decide the key source (file > env > lightsail) and write the key file.
os::ssh_resolve_key() {
    local name=$1 source=$OPT_SSH_KEY_SOURCE dest="$RUN_DIR/id_key"
    if [[ $source == auto ]]; then
        if [[ -n $OPT_SSH_KEY_FILE ]]; then
            source="file"
        elif [[ -n ${OCTOSAIL_SSH_PRIVATE_KEY:-} ]]; then
            source="env"
        else
            source="lightsail"
        fi
    fi
    case $source in
        file)
            [[ -n $OPT_SSH_KEY_FILE ]] || os::die "$EX_USAGE" "--key-source file requires --key-file or OCTOSAIL_SSH_KEY_FILE"
            [[ -f $OPT_SSH_KEY_FILE ]] || os::die "$EX_USAGE" "private key file '$OPT_SSH_KEY_FILE' not found"
            os::write_secret_file "$dest" "$(cat "$OPT_SSH_KEY_FILE")" 600
            SSH_KEY_FILE=$dest
            ;;
        env)
            [[ -n ${OCTOSAIL_SSH_PRIVATE_KEY:-} ]] || os::die "$EX_USAGE" "--key-source env requires OCTOSAIL_SSH_PRIVATE_KEY"
            os::ssh_key_from_env "$dest"
            SSH_KEY_FILE=$dest
            ;;
        lightsail)
            [[ -n $ACCESS_JSON ]] || os::ssh_access_fetch "$name"
            if ! os::ssh_write_lightsail_key; then
                os::ssh_default_key_download "$name" "$dest"
                SSH_KEY_FILE=$dest
                SSH_CERT_FILE=""
            fi
            ;;
        *) os::die "$EX_USAGE" "--key-source must be auto, file, env or lightsail (got '$source')" ;;
    esac
    SSH_KEY_SOURCE_USED=$source
    os::ssh_validate_key "$SSH_KEY_FILE"
    os::debug "ssh private key source: $source"
}

# os::ssh_refresh_access NAME - re-fetch access details when the temporary key is about to expire.
os::ssh_refresh_access() {
    local name=$1 now
    [[ $SSH_KEY_SOURCE_USED == lightsail || $OPT_HOST_KEY_POLICY == lightsail ]] || return 0
    [[ -n $ACCESS_JSON ]] || return 0
    (( ACCESS_EXPIRES > 0 )) || return 0
    now=$(os::now_epoch)
    if (( now >= ACCESS_EXPIRES - 60 )); then
        os::info "temporary access credentials are expiring; refreshing"
        os::ssh_access_fetch "$name"
        if [[ $SSH_KEY_SOURCE_USED == lightsail ]]; then
            os::ssh_write_lightsail_key || true
        fi
        if [[ $OPT_HOST_KEY_POLICY == lightsail ]]; then
            os::ssh_known_hosts_lightsail || true
        fi
    fi
}

# os::ssh_resolve_target - user@host:port from overrides, access details and the instance.
os::ssh_resolve_target() {
    SSH_USER=$OPT_SSH_USER
    if [[ -z $SSH_USER && -n $ACCESS_JSON ]]; then
        SSH_USER=$(jq -r '.username // empty' <<<"$ACCESS_JSON")
    fi
    [[ -n $SSH_USER ]] || SSH_USER=$INST_USERNAME
    [[ -n $SSH_USER ]] || os::die "$EX_SSH" "cannot determine the SSH user for '$INST_NAME'; use --user"
    SSH_HOST=$OPT_SSH_HOST
    [[ -n $SSH_HOST ]] || SSH_HOST=$INST_PUBLIC_IP
    [[ -n $SSH_HOST ]] || os::die "$EX_SSH" "instance '$INST_NAME' has no public IPv4 address; use --host"
    SSH_PORT=${OPT_SSH_PORT:-22}
}

# os::ssh_known_hosts_lightsail - pin the host keys Lightsail witnessed. Returns 1 while none are published.
os::ssh_known_hosts_lightsail() {
    local file="$RUN_DIR/known_hosts" now entries alg key fp nva exp count=0 hostspec
    now=$(os::now_epoch)
    entries=$(jq -r '(.hostKeys // [])[] | select(.publicKey != null and .algorithm != null)
        | [.algorithm, .publicKey, (.fingerprintSHA256 // ""), (.notValidAfter // "")] | join("\u001f")' <<<"$ACCESS_JSON")
    : >"$file"
    chmod 600 "$file"
    hostspec=$SSH_HOST
    if (( SSH_PORT != 22 )); then
        hostspec="[$SSH_HOST]:$SSH_PORT"
    fi
    while IFS=$'\x1f' read -r alg key fp nva; do
        [[ -n $alg && -n $key ]] || continue
        if [[ -n $nva ]]; then
            exp=$(os::iso_to_epoch "$nva")
            if (( exp > 0 && exp < now )); then
                os::debug "skipping expired host key ${fp:-$alg}"
                continue
            fi
        fi
        printf '%s %s %s\n' "$hostspec" "$alg" "$key" >>"$file"
        count=$((count + 1))
        if [[ -n $fp && -z ${HOST_KEYS_LOGGED[$fp]+x} ]]; then
            HOST_KEYS_LOGGED[$fp]=1
            os::info "pinned host key $alg $fp for $SSH_HOST"
        fi
    done <<<"$entries"
    (( count > 0 )) || return 1
    SSH_KNOWN_HOSTS=$file
    SSH_STRICT=yes
    return 0
}

# os::ssh_known_hosts_static - known_hosts handling for the non-lightsail policies.
os::ssh_known_hosts_static() {
    case $OPT_HOST_KEY_POLICY in
        accept-new)
            SSH_KNOWN_HOSTS="$RUN_DIR/known_hosts"
            [[ -f $SSH_KNOWN_HOSTS ]] || { : >"$SSH_KNOWN_HOSTS"; chmod 600 "$SSH_KNOWN_HOSTS"; }
            SSH_STRICT=accept-new
            if [[ -z ${HOST_KEYS_LOGGED[accept-new]+x} ]]; then
                HOST_KEYS_LOGGED[accept-new]=1
                os::warn "host-key policy accept-new: the first key presented by $SSH_HOST is trusted for this invocation"
            fi
            ;;
        known-hosts)
            SSH_KNOWN_HOSTS=${OPT_KNOWN_HOSTS_FILE:-${HOME:-}/.ssh/known_hosts}
            [[ -f $SSH_KNOWN_HOSTS ]] || os::die "$EX_SSH" "known_hosts file '$SSH_KNOWN_HOSTS' not found"
            SSH_STRICT=yes
            ;;
        none)
            SSH_KNOWN_HOSTS=/dev/null
            SSH_STRICT=no
            os::warn "host-key policy none: host keys are NOT verified for $SSH_HOST"
            ;;
        lightsail) return 0 ;;
        *) os::die "$EX_USAGE" "--host-key-policy must be lightsail, accept-new, known-hosts or none (got '$OPT_HOST_KEY_POLICY')" ;;
    esac
}

# os::ssh_opts - build SSH_OPTS and SCP_OPTS from the resolved session state.
os::ssh_opts() {
    local -a common=(-o BatchMode=yes -o IdentitiesOnly=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no
        -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o LogLevel=ERROR -o UpdateHostKeys=no
        -o ControlMaster=no -o "UserKnownHostsFile=$SSH_KNOWN_HOSTS" -o "StrictHostKeyChecking=$SSH_STRICT" -i "$SSH_KEY_FILE")
    if [[ -n $SSH_CERT_FILE ]]; then
        common+=(-o "CertificateFile=$SSH_CERT_FILE")
    fi
    SSH_OPTS=("${common[@]}" -p "$SSH_PORT")
    SCP_OPTS=("${common[@]}" -P "$SSH_PORT")
    local extra
    for extra in "${OPT_SSH_EXTRA_OPTS[@]+"${OPT_SSH_EXTRA_OPTS[@]}"}"; do
        SSH_OPTS+=(-o "$extra")
        SCP_OPTS+=(-o "$extra")
    done
}

# os::ssh_wait NAME BUDGET FAIL_CODE - prepare keys/host keys and probe until `ssh ... true` succeeds.
os::ssh_wait() {
    local name=$1 budget=$2 fail_code=$3
    local deadline=$((SECONDS + budget)) attempts=0 max_attempts interval=5 rc probe_err errfile="$RUN_DIR/ssh.err"
    max_attempts=$(os::max_attempts "$budget")
    if [[ $DRY_RUN == true ]]; then
        os::info "DRY-RUN: would wait for ssh on instance '$name'"
        SSH_READY=true
        return 0
    fi
    [[ -n $SSH_KEY_FILE ]] || os::ssh_resolve_key "$name"
    os::ssh_resolve_target
    while :; do
        os::global_deadline_check
        if [[ $OPT_HOST_KEY_POLICY == lightsail ]]; then
            [[ -n $ACCESS_JSON ]] || os::ssh_access_fetch "$name"
            if ! os::ssh_known_hosts_lightsail; then
                os::debug "Lightsail has not published host keys for '$name' yet"
                attempts=$((attempts + 1))
                if (( SECONDS >= deadline || attempts >= max_attempts )); then
                    os::die "$EX_TIMEOUT" "host keys were never published by Lightsail for '$name' within ${budget}s; use --host-key-policy accept-new for blueprints that do not publish them"
                fi
                os::sleep "$interval"
                interval=$(os::backoff "$interval" 20)
                ACCESS_JSON=""
                continue
            fi
        else
            os::ssh_known_hosts_static
        fi
        os::ssh_refresh_access "$name"
        os::ssh_opts
        rc=0
        os::with_timeout 30 /dev/null - "$errfile" ssh "${SSH_OPTS[@]}" "$SSH_USER@$SSH_HOST" -- true || rc=$?
        if (( rc == 0 )); then
            os::info "ssh is ready on $SSH_USER@$SSH_HOST"
            SSH_READY=true
            return 0
        fi
        probe_err=$(grep -v '^$' "$errfile" 2>/dev/null | tail -n1 || true)
        if [[ -n $probe_err && $probe_err =~ $SSH_FATAL_RE ]] || grep -qE "$SSH_FATAL_RE" "$errfile" 2>/dev/null; then
            os::die "$EX_SSH" "ssh to $SSH_USER@$SSH_HOST failed permanently: ${probe_err:-see above}"
        fi
        attempts=$((attempts + 1))
        if (( SECONDS >= deadline || attempts >= max_attempts )); then
            os::die "$fail_code" "ssh to $SSH_USER@$SSH_HOST not ready within ${budget}s: ${probe_err:-no response}"
        fi
        os::debug "ssh not ready yet (${probe_err:-no response}); retrying"
        os::sleep "$interval"
        interval=$(os::backoff "$interval" 20)
    done
}

# os::ssh_build_script BODY_FILE OUT_FILE - prelude (strict mode, env, cwd) + the user's script.
os::ssh_build_script() {
    local body=$1 out=$2 kv key val
    {
        printf '#!/usr/bin/env %s\n' "$OPT_SHELL"
        if [[ $OPT_STRICT == true ]]; then
            if [[ $OPT_SHELL == bash ]]; then
                printf 'set -euo pipefail\n'
            else
                printf 'set -eu\n'
            fi
        fi
        for kv in "${OPT_ENV[@]+"${OPT_ENV[@]}"}"; do
            key=${kv%%=*}
            val=${kv#*=}
            printf 'export %s=%s\n' "$key" "$(os::shell_quote "$val")"
        done
        if [[ -n $OPT_CWD ]]; then
            printf 'cd -- %s || exit 2\n' "$(os::shell_quote "$OPT_CWD")"
        fi
        cat "$body"
        printf '\n'
    } >"$out"
}

# os::ssh_run_script NAME SCRIPT_FILE TIMEOUT CAPTURE_DIR - execute the script exactly once. Returns its status (124 = timeout).
os::ssh_run_script() {
    local name=$1 script=$2 limit=$3 capture=$4 rc=0
    local -a remote=("$OPT_SHELL" -s)
    if [[ $OPT_SUDO == true ]]; then
        remote=(sudo -n -H -- "${remote[@]}")
    fi
    os::ssh_refresh_access "$name"
    os::ssh_opts
    if [[ $DRY_RUN == true ]]; then
        os::info "DRY-RUN: ssh $SSH_USER@$SSH_HOST -- ${remote[*]} < $script"
        return 0
    fi
    os::debug "ssh: $(os::redact_argv ssh "${SSH_OPTS[@]}" "$SSH_USER@$SSH_HOST" -- "${remote[@]}")"
    if [[ -n $capture ]]; then
        mkdir -p "$capture"
        local out="$capture/stdout.log" err="$capture/stderr.log" fifo_out="$RUN_DIR/out.fifo" fifo_err="$RUN_DIR/err.fifo" tee_out tee_err
        rm -f "$fifo_out" "$fifo_err"
        mkfifo "$fifo_out" "$fifo_err"
        if [[ $JSON_MODE == true ]]; then
            tee "$out" <"$fifo_out" >/dev/null &
        else
            tee "$out" <"$fifo_out" &
        fi
        tee_out=$!
        tee "$err" <"$fifo_err" >&2 &
        tee_err=$!
        os::with_timeout "$limit" "$script" "$fifo_out" "$fifo_err" ssh "${SSH_OPTS[@]}" "$SSH_USER@$SSH_HOST" -- "${remote[@]}" || rc=$?
        wait "$tee_out" "$tee_err" 2>/dev/null || true
        rm -f "$fifo_out" "$fifo_err"
    else
        os::with_timeout "$limit" "$script" - - ssh "${SSH_OPTS[@]}" "$SSH_USER@$SSH_HOST" -- "${remote[@]}" || rc=$?
    fi
    return "$rc"
}

BOOT_ID=""

# os::ssh_boot_id NAME - BOOT_ID = the remote boot id (empty on failure).
os::ssh_boot_id() {
    local name=$1 rc=0 file="$RUN_DIR/boot_id"
    BOOT_ID=""
    os::ssh_refresh_access "$name"
    os::ssh_opts
    os::with_timeout 30 /dev/null "$file" /dev/null ssh "${SSH_OPTS[@]}" "$SSH_USER@$SSH_HOST" -- cat /proc/sys/kernel/random/boot_id || rc=$?
    if (( rc == 0 )) && [[ -f $file ]]; then
        BOOT_ID=$(tr -d '[:space:]' <"$file")
    fi
    rm -f "$file"
}

# os::cloud_init_wait NAME BUDGET - run the remote cloud-init wait; sets CLOUD_INIT_STATUS. Returns 0, EX_CLOUDINIT or EX_TIMEOUT.
os::cloud_init_wait() {
    local name=$1 budget=$2 rc=0 script="$RUN_DIR/cloud-init.sh" outfile="$RUN_DIR/cloud-init.out" status
    cat >"$script" <<EOF
budget=$budget
if command -v cloud-init >/dev/null 2>&1; then
    s=""
    if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then s="sudo -n"; fi
    t=""
    if command -v timeout >/dev/null 2>&1; then t="timeout \$budget"; fi
    \$t \$s cloud-init status --wait >/dev/null 2>&1
    rc=\$?
    if [ "\$rc" -eq 124 ]; then echo "$CLOUD_INIT_MARKER timeout"; exit 0; fi
    st=\$(\$s cloud-init status 2>/dev/null | sed -n 's/^status:[[:space:]]*//p' | head -n 1 | tr -d '[:space:]')
    case "\$st" in
        done|error|degraded) echo "$CLOUD_INIT_MARKER \$st" ;;
        running|"") if [ "\$rc" -eq 0 ]; then echo "$CLOUD_INIT_MARKER done"; elif [ "\$rc" -eq 2 ]; then echo "$CLOUD_INIT_MARKER degraded"; elif [ "\$rc" -eq 1 ]; then echo "$CLOUD_INIT_MARKER error"; else echo "$CLOUD_INIT_MARKER unknown"; fi ;;
        *) echo "$CLOUD_INIT_MARKER unknown" ;;
    esac
elif [ -f /var/lib/cloud/instance/boot-finished ]; then
    echo "$CLOUD_INIT_MARKER done"
else
    echo "$CLOUD_INIT_MARKER absent"
fi
EOF
    if [[ $DRY_RUN == true ]]; then
        CLOUD_INIT_STATUS="skipped"
        return 0
    fi
    os::info "waiting for cloud-init on $SSH_USER@$SSH_HOST (up to ${budget}s)"
    os::ssh_refresh_access "$name"
    os::ssh_opts
    os::with_timeout $((budget + 60)) "$script" "$outfile" - ssh "${SSH_OPTS[@]}" "$SSH_USER@$SSH_HOST" -- sh -s || rc=$?
    if [[ $TIMED_OUT == true ]]; then
        [[ $TIMEOUT_REASON == global ]] && os::die "$EX_TIMEOUT" "global timeout of ${GLOBAL_TIMEOUT}s exceeded while waiting for cloud-init"
        CLOUD_INIT_STATUS="timeout"
        return "$EX_TIMEOUT"
    fi
    status=$(grep "^$CLOUD_INIT_MARKER" "$outfile" 2>/dev/null | tail -n1 | awk '{print $2}')
    if (( rc != 0 )) && [[ -z $status ]]; then
        CLOUD_INIT_STATUS="unknown"
        os::warn "cloud-init status could not be determined (ssh exit $rc)"
        return 0
    fi
    CLOUD_INIT_STATUS=${status:-unknown}
    case $CLOUD_INIT_STATUS in
        done|absent) os::info "cloud-init: $CLOUD_INIT_STATUS"; return 0 ;;
        unknown) os::warn "cloud-init: status unknown"; return 0 ;;
        degraded)
            if [[ $OPT_CLOUD_INIT_STRICT == true ]]; then
                return "$EX_CLOUDINIT"
            fi
            os::warn "cloud-init finished in a degraded state (some modules reported errors)"
            return 0
            ;;
        error) return "$EX_CLOUDINIT" ;;
        timeout) return "$EX_TIMEOUT" ;;
        *) os::warn "cloud-init: unexpected status '$CLOUD_INIT_STATUS'"; return 0 ;;
    esac
}

# os::scp NAME [-r] SRC... DEST - copy with the session's options; remote paths must already be user@host:path.
os::scp() {
    local name=$1 rc=0
    shift
    os::ssh_refresh_access "$name"
    os::ssh_opts
    if [[ $DRY_RUN == true ]]; then
        os::info "DRY-RUN: scp $*"
        return 0
    fi
    os::debug "scp: $(os::redact_argv scp "${SCP_OPTS[@]}" "$@")"
    os::with_timeout 0 /dev/null - - scp "${SCP_OPTS[@]}" "$@" || rc=$?
    return "$rc"
}

SCP_LEGACY=""

# os::scp_is_legacy - true when the local OpenSSH is older than 9.0 (scp still expands remote paths in a shell).
os::scp_is_legacy() {
    if [[ -z $SCP_LEGACY ]]; then
        local v major
        v=$(ssh -V 2>&1 | sed -n 's/^OpenSSH_\([0-9][0-9]*\)\..*/\1/p' | head -n1)
        major=${v:-9}
        if [[ $major =~ ^[0-9]+$ ]] && (( major < 9 )); then
            SCP_LEGACY=true
        else
            SCP_LEGACY=false
        fi
    fi
    [[ $SCP_LEGACY == true ]]
}

# os::remote_path PATH - user@host:PATH for scp. Paths with shell-special characters are quoted for the
# legacy scp protocol (OpenSSH < 9.0), where the remote side expands them in a shell.
os::remote_path() {
    local path=$1
    if [[ ! $path =~ ^[A-Za-z0-9._/~+@:=,-]+$ ]] && os::scp_is_legacy; then
        path=$(os::shell_quote "$path")
    fi
    printf '%s@%s:%s' "$SSH_USER" "$SSH_HOST" "$path"
}

# os::transfer NAME MODE SPEC - upload "LOCAL:REMOTE" or download "REMOTE:LOCAL" (SPEC split at the first colon).
os::transfer() {
    local name=$1 mode=$2 spec=$3 src dest rc=0
    local -a flags=()
    [[ $spec == *:* ]] || os::die "$EX_USAGE" "$mode spec '$spec' must be SRC:DEST"
    src=${spec%%:*}
    dest=${spec#*:}
    [[ -n $src && -n $dest ]] || os::die "$EX_USAGE" "$mode spec '$spec' must be SRC:DEST with both sides set"
    if [[ $OPT_COPY_RECURSIVE == true ]]; then
        flags+=(-r)
    fi
    case $mode in
        upload)
            [[ -e $src ]] || os::die "$EX_USAGE" "upload source '$src' does not exist"
            os::info "uploading $src -> $SSH_HOST:$dest"
            os::scp "$name" "${flags[@]+"${flags[@]}"}" "$src" "$(os::remote_path "$dest")" || rc=$?
            ;;
        download)
            mkdir -p "$(dirname -- "$dest")" 2>/dev/null || true
            os::info "downloading $SSH_HOST:$src -> $dest"
            os::scp "$name" "${flags[@]+"${flags[@]}"}" "$(os::remote_path "$src")" "$dest" || rc=$?
            ;;
    esac
    return "$rc"
}

###############################################################################
# Lifecycle: delete guard, delete flow, cleanup, traps
###############################################################################

# os::delete_guard NAME - refuse to delete protected or unmanaged instances (unless --yes).
os::delete_guard() {
    local name=$1
    if os::instance_is_protected; then
        os::die "$EX_REFUSED" "instance '$name' is tagged $TAG_PROTECTED=true; refusing to delete it (remove the tag first)"
    fi
    if os::instance_is_managed; then
        return 0
    fi
    if [[ $ASSUME_YES == true ]]; then
        os::warn "instance '$name' is not managed by octosail; deleting it because --yes was given"
        return 0
    fi
    os::die "$EX_REFUSED" "instance '$name' is not managed by octosail (no $TAG_MANAGED=true tag); re-run with --yes, or tag the instance $TAG_MANAGED=true"
}

# os::delete_flow NAME - the complete, guarded, idempotent decommission of one instance.
# Uses OPT_WAIT, OPT_IF_MISSING, OPT_SNAPSHOT_FIRST, OPT_RELEASE_STATIC_IP, OPT_DELETE_KEY_PAIR,
# OPT_FORCE_DELETE_ADD_ONS, OPT_DELETE_TIMEOUT, OPT_SNAPSHOT_TIMEOUT. Terminates on failure.
os::delete_flow() {
    local name=$1 rc=0 snap="" ipname="" kp="" rc2=0
    local -a args=()
    os::out_declare name deleted snapshot_name static_ip_released key_pair_deleted dry_run
    os::out name "$name"
    os::out dry_run "$DRY_RUN"
    os::instance_get "$name" || rc=$?
    if (( rc == EX_NOTFOUND )); then
        if [[ $OPT_IF_MISSING == fail ]]; then
            os::die "$EX_NOTFOUND" "instance '$name' does not exist"
        fi
        os::info "instance '$name' does not exist; nothing to delete"
        os::out deleted false
        return 0
    fi
    os::delete_guard "$name"
    if [[ -n $OPT_SNAPSHOT_FIRST ]]; then
        if [[ $OPT_SNAPSHOT_FIRST == true ]]; then
            snap="${name}-$(date -u +%Y%m%d%H%M%S)"
        else
            snap=$OPT_SNAPSHOT_FIRST
        fi
        os::validate_name "$snap" "snapshot name"
        os::snapshot_create "$name" "$snap" "$OPT_SNAPSHOT_TIMEOUT"
        os::out snapshot_name "$snap"
    fi
    if [[ $INST_IS_STATIC == true ]]; then
        ipname=$(os::instance_tag "$TAG_STATIC_IP")
        if [[ -n $ipname || $OPT_RELEASE_STATIC_IP == true ]]; then
            if [[ -z $ipname ]]; then
                os::static_ip_find_attached "$name"
                ipname=$STATIC_IP_FOUND
            fi
            if [[ -n $ipname ]]; then
                os::static_ip_release "$ipname"
                os::out static_ip_released true
            else
                os::warn "instance '$name' has a static IP but its name could not be determined; not released"
            fi
        else
            os::info "instance '$name' has a static IP that octosail did not allocate; keeping it (use --release-static-ip)"
        fi
    fi
    if [[ $OPT_FORCE_DELETE_ADD_ONS == true ]]; then
        args+=(--force-delete-add-ons)
    fi
    os::info "deleting instance '$name'"
    os::aws lightsail delete-instance --instance-name "$name" "${args[@]+"${args[@]}"}" || rc2=$?
    if (( rc2 == EX_NOTFOUND )); then
        os::info "instance '$name' vanished before the delete call"
        os::out deleted false
        return 0
    fi
    (( rc2 == 0 )) || os::die "$EX_AWS" "delete-instance $name failed: $AWS_ERR"
    os::op_wait "$AWS_OUT"
    if [[ $OPT_WAIT == true ]]; then
        os::absent_wait "$name" "$OPT_DELETE_TIMEOUT" || os::die "$EX_TIMEOUT" "instance '$name' still exists after ${OPT_DELETE_TIMEOUT}s"
        os::info "instance '$name' has been deleted"
    fi
    kp=$(os::instance_tag "$TAG_KEY_PAIR")
    if [[ -z $kp && $OPT_DELETE_KEY_PAIR == true && -n $INST_KEY_NAME && $INST_KEY_NAME != "$DEFAULT_KEY_PAIR_PREFIX"* ]]; then
        kp=$INST_KEY_NAME
    fi
    if [[ -n $kp ]]; then
        rc2=0
        os::info "deleting key pair '$kp'"
        os::aws lightsail delete-key-pair --key-pair-name "$kp" || rc2=$?
        if (( rc2 == 0 )); then
            os::op_wait "$AWS_OUT"
            os::out key_pair_deleted true
        elif (( rc2 == EX_NOTFOUND )); then
            os::info "key pair '$kp' no longer exists"
        else
            os::warn "could not delete key pair '$kp': $AWS_ERR"
        fi
    fi
    os::out deleted true
    return 0
}

# os::cleanup_run - the delete phase of `run` (also executed from the EXIT trap after a failure or signal).
os::cleanup_run() {
    [[ $CLEANUP_DONE == true ]] && return 0
    CLEANUP_DONE=true
    local name=$CLEANUP_INSTANCE pending=${EXIT_CODE:-0} rc=0 wait_flag=$OPT_CLEANUP_WAIT result=""
    [[ -n $name ]] || return 0
    GLOBAL_DEADLINE=0
    os::out_declare deleted leaked_instance cleanup_error
    if [[ $RUN_CREATED != true && $CLEANUP_INSTANCE_EXISTS != true ]]; then
        os::out deleted false
        return 0
    fi
    case $OPT_DELETE_POLICY in
        never)
            os::notice "instance '$name' kept (--delete-policy never)"
            os::out deleted skipped
            return 0
            ;;
        created)
            if [[ $RUN_CREATED != true ]]; then
                os::notice "instance '$name' was reused, not created; kept (--delete-policy created)"
                os::out deleted skipped
                return 0
            fi
            ;;
        always) ;;
    esac
    if [[ $OPT_KEEP_ON_FAILURE == true && $pending -ne 0 ]]; then
        os::warn "instance '$name' kept for inspection (--keep-on-failure); public IP: ${INST_PUBLIC_IP:-unknown}"
        os::out deleted skipped
        return 0
    fi
    os::group "delete $name"
    result=$(
        OPT_WAIT=$wait_flag
        OPT_IF_MISSING=ok
        os::delete_flow "$name"
        os::out_get deleted
    ) || rc=$?
    os::endgroup
    if (( rc == 0 )); then
        os::out deleted "${result:-true}"
        return 0
    fi
    os::out deleted false
    os::out leaked_instance "$name"
    os::out cleanup_error "delete failed with exit $rc ($(os::exit_name "$rc"))"
    os::error "cleanup failed: instance '$name' may still exist (delete it with: octosail delete $name)"
    if (( pending == 0 )); then
        EXIT_CODE=$EX_CLEANUP
    fi
    return "$rc"
}

# os::on_exit - runs once for every termination path.
os::on_exit() {
    local rc=$?
    trap - EXIT ERR INT TERM
    set +e
    [[ -n $EXIT_CODE ]] || EXIT_CODE=$rc
    if [[ -n $RUN_PHASE && $EXIT_CODE -ne 0 && -z ${OUT[phase_failed]:-} ]]; then
        os::out phase_failed "$RUN_PHASE"
    fi
    if [[ -n $CLEANUP_INSTANCE && $CLEANUP_DONE != true ]]; then
        os::cleanup_run
    fi
    os::out exit_code "$EXIT_CODE"
    os::out exit_name "$(os::exit_name "$EXIT_CODE")"
    os::out octosail_version "$_VERSION"
    os::out_flush
    os::summary
    os::json_result "$EXIT_CODE"
    os::rundir_cleanup
    exit "$EXIT_CODE"
}

# os::on_signal NAME - SIGINT/SIGTERM: stop the child, run a non-waiting cleanup, exit 130/143.
os::on_signal() {
    local sig=$1 code
    case $sig in
        INT) code=130 ;;
        TERM) code=143 ;;
        *) code=1 ;;
    esac
    trap - INT TERM
    os::warn "received SIG$sig; stopping"
    if [[ -n $CHILD_PID ]]; then
        kill -TERM "$CHILD_PID" 2>/dev/null || true
    fi
    OPT_CLEANUP_WAIT=false
    EXIT_CODE=$code
    exit "$code"
}

# os::on_err LINE STATUS - unexpected failure of an unguarded command.
os::on_err() {
    local line=$1 status=$2
    [[ -n $EXIT_CODE ]] || EXIT_CODE=$EX_GENERAL
    os::error "internal error: command failed with status $status at line $line"
}

CLEANUP_INSTANCE_EXISTS=false

# os::install_traps
os::install_traps() {
    trap 'os::on_exit' EXIT
    trap 'os::on_signal INT' INT
    trap 'os::on_signal TERM' TERM
    trap 'os::on_err "$LINENO" "$?"' ERR
}

