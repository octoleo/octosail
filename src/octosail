}

os::parse_opt_power() {
    local verb=$1
    case $OPT_FLAG in
        --wait) os::opt_bool; OPT_WAIT=$BOOL ;;
        --no-wait) os::opt_flag; OPT_WAIT=false; OPT_WAIT_SSH=false ;;
        --wait-ssh)
            [[ $verb != stop ]] || return 1
            os::opt_bool
            OPT_WAIT_SSH=$BOOL
            ;;
        --state-timeout) os::opt_seconds; OPT_STATE_TIMEOUT=$SECS ;;
        --force)
            [[ $verb == stop ]] || return 1
            os::opt_bool
            OPT_FORCE_STOP=$BOOL
            ;;
        --hard)
            [[ $verb == reboot ]] || return 1
            os::opt_bool
            OPT_HARD=$BOOL
            ;;
        *) return 1 ;;
    esac
    return 0
}

