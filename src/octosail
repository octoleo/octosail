###############################################################################
# Option parsing primitives
###############################################################################

# os::opt_split "$@" - split the current argument into OPT_FLAG / OPT_VALUE (for --flag=value).
os::opt_split() {
    OPT_FLAG=$1
    OPT_INLINE=false
    OPT_VALUE=""
    OPT_NEXT=${2-}
    OPT_HAS_NEXT=$(( $# >= 2 ))
    OPT_SHIFT=1
    if [[ $1 == --*=* ]]; then
        OPT_FLAG=${1%%=*}
        OPT_VALUE=${1#*=}
        OPT_INLINE=true
    fi
}

# os::opt_take - the flag needs a non-empty value (inline or the next argument).
os::opt_take() {
    if [[ $OPT_INLINE == true ]]; then
        OPT_SHIFT=1
    else
        (( OPT_HAS_NEXT )) || os::die "$EX_USAGE" "option $OPT_FLAG requires a value"
        OPT_VALUE=$OPT_NEXT
        OPT_SHIFT=2
    fi
    [[ -n $OPT_VALUE ]] || os::die "$EX_USAGE" "option $OPT_FLAG requires a non-empty value"
    [[ $OPT_VALUE != --* ]] || os::die "$EX_USAGE" "option $OPT_FLAG requires a value (got '$OPT_VALUE')"
}

# os::opt_flag - the flag takes no value.
os::opt_flag() {
    [[ $OPT_INLINE != true ]] || os::die "$EX_USAGE" "option $OPT_FLAG does not take a value"
    OPT_SHIFT=1
}

# os::opt_bool - boolean flag; --flag=false is accepted. Result in BOOL.
os::opt_bool() {
    OPT_SHIFT=1
    if [[ $OPT_INLINE == true ]]; then
        os::to_bool "$OPT_VALUE" "$OPT_FLAG"
    else
        BOOL=true
    fi
}

# os::opt_seconds - duration-valued flag. Result in SECS.
os::opt_seconds() {
    os::opt_take
    os::to_seconds "$OPT_VALUE" "$OPT_FLAG"
}

os::set_log_level() {
    case $1 in
        error) LOG_LEVEL_NUM=0 ;;
        warn|warning) LOG_LEVEL_NUM=1 ;;
        info) LOG_LEVEL_NUM=2 ;;
        debug) LOG_LEVEL_NUM=3 ;;
        *) os::die "$EX_USAGE" "log level must be error, warn, info or debug (got '$1')" ;;
    esac
}

# os::parse_opt_global - consume one global option; returns 1 when OPT_FLAG is not a global option.
os::parse_opt_global() {
    case $OPT_FLAG in
        --region) os::opt_take; REGION=$OPT_VALUE ;;
        --profile) os::opt_take; PROFILE=$OPT_VALUE ;;
        --config) os::opt_take ;;
        --json) os::opt_bool; JSON_MODE=$BOOL ;;
        -q|--quiet) os::opt_flag; LOG_LEVEL_NUM=1 ;;
        -v|--verbose) os::opt_flag; LOG_LEVEL_NUM=3 ;;
        --log-level) os::opt_take; os::set_log_level "$OPT_VALUE" ;;
        --no-color) os::opt_flag; COLOR_ENABLED=false ;;
        --poll-interval)
            os::opt_seconds
            (( SECS >= 1 )) || os::die "$EX_USAGE" "--poll-interval must be at least 1 second"
            POLL_INTERVAL=$SECS
            (( POLL_INTERVAL_MAX < POLL_INTERVAL )) && POLL_INTERVAL_MAX=$POLL_INTERVAL
            ;;
        --timeout)
            os::opt_seconds
            GLOBAL_TIMEOUT=$SECS
            GLOBAL_DEADLINE=$((SECONDS + SECS))
            ;;
        --github-output) os::opt_take; OUTPUT_FILE=$OPT_VALUE ;;
        --output-prefix) os::opt_take; OUTPUT_PREFIX=$OPT_VALUE ;;
        --no-step-summary) os::opt_flag; STEP_SUMMARY=false ;;
        --dry-run) os::opt_bool; DRY_RUN=$BOOL ;;
        --keep-temp) os::opt_bool; KEEP_TEMP=$BOOL ;;
        -y|--yes) os::opt_bool; ASSUME_YES=$BOOL ;;
        -h|--help)
            os::opt_flag
            cmd_help "$COMMAND"
            EXIT_CODE=0
            exit 0
            ;;
        -V|--version)
            os::opt_flag
            # shellcheck disable=SC2119 # no arguments to forward here
            cmd_version
            EXIT_CODE=0
            exit 0
            ;;
        *) return 1 ;;
    esac
    return 0
}

os::parse_opt_ssh() {
    case $OPT_FLAG in
        -i|--key-file) os::opt_take; OPT_SSH_KEY_FILE=$OPT_VALUE ;;
        --key-source) os::opt_take; OPT_SSH_KEY_SOURCE=$OPT_VALUE ;;
        -u|--user) os::opt_take; OPT_SSH_USER=$OPT_VALUE ;;
        --host) os::opt_take; OPT_SSH_HOST=$OPT_VALUE ;;
        --ssh-port)
            os::opt_take
            if [[ ! $OPT_VALUE =~ ^[0-9]+$ ]] || (( OPT_VALUE < 1 || OPT_VALUE > 65535 )); then
                os::die "$EX_USAGE" "--ssh-port must be 1-65535"
            fi
            OPT_SSH_PORT=$OPT_VALUE
            ;;
        --host-key-policy)
            os::opt_take
            case $OPT_VALUE in
                lightsail|accept-new|known-hosts|none) OPT_HOST_KEY_POLICY=$OPT_VALUE ;;
                *) os::die "$EX_USAGE" "--host-key-policy must be lightsail, accept-new, known-hosts or none" ;;
            esac
            ;;
        --known-hosts) os::opt_take; OPT_KNOWN_HOSTS_FILE=$OPT_VALUE ;;
        --ssh-opt) os::opt_take; OPT_SSH_EXTRA_OPTS+=("$OPT_VALUE") ;;
        --ssh-timeout) os::opt_seconds; OPT_SSH_TIMEOUT=$SECS ;;
        *) return 1 ;;
    esac
    return 0
}

os::parse_opt_create() {
    case $OPT_FLAG in
        -b|--blueprint) os::opt_take; OPT_BLUEPRINT=$OPT_VALUE ;;
        -B|--bundle) os::opt_take; OPT_BUNDLE=$OPT_VALUE ;;
        -z|--availability-zone) os::opt_take; OPT_AZ=$OPT_VALUE ;;
        --from-snapshot) os::opt_take; OPT_FROM_SNAPSHOT=$OPT_VALUE ;;
        --user-data) os::opt_take; OPT_USER_DATA=$OPT_VALUE ;;
        --user-data-file) os::opt_take; OPT_USER_DATA_FILE=$OPT_VALUE ;;
        --key-pair) os::opt_take; OPT_KEY_PAIR=$OPT_VALUE ;;
        --public-key-file) os::opt_take; OPT_PUBLIC_KEY_FILE=$OPT_VALUE ;;
        -t|--tag) os::opt_take; OPT_TAGS+=("$OPT_VALUE") ;;
        --ttl) os::opt_seconds; OPT_TTL=$SECS ;;
        -p|--open-ports) os::opt_take; OPT_OPEN_PORTS+=("$OPT_VALUE") ;;
        --static-ip) os::opt_bool; OPT_STATIC_IP=$BOOL ;;
        --static-ip-name) os::opt_take; OPT_STATIC_IP_NAME=$OPT_VALUE ;;
        --ip-address-type)
            os::opt_take
            case $OPT_VALUE in
                dualstack|ipv4|ipv6) OPT_IP_ADDRESS_TYPE=$OPT_VALUE ;;
                *) os::die "$EX_USAGE" "--ip-address-type must be dualstack, ipv4 or ipv6" ;;
            esac
            ;;
        --if-exists)
            os::opt_take
            case $OPT_VALUE in
                reuse|fail|replace) OPT_IF_EXISTS=$OPT_VALUE ;;
                *) os::die "$EX_USAGE" "--if-exists must be reuse, fail or replace" ;;
            esac
            ;;
        --wait) os::opt_bool; OPT_WAIT=$BOOL ;;
        --no-wait) os::opt_flag; OPT_WAIT=false; OPT_WAIT_SSH=false ;;
        --wait-ssh) os::opt_bool; OPT_WAIT_SSH=$BOOL ;;
        --no-wait-ssh) os::opt_flag; OPT_WAIT_SSH=false ;;
        --cloud-init-wait)
            os::opt_take
            case $OPT_VALUE in
                auto) OPT_CLOUD_INIT_WAIT=auto ;;
